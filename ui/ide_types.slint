// Modelos de datos compartidos por los paneles de NuIde.
//
// Son deliberadamente planos: la UI recibe listas de structs y las dibuja; no
// conoce rutas ni procesos. Rust (o más adelante el motor real) es quien llena
// estas listas.

// Nodo del explorador de archivos.
// kind: 0 archivo, 1 carpeta cerrada, 2 carpeta abierta, 3 configuración.
export struct IdeTreeNode {
    depth: int,
    label: string,
    kind: int,
}

// Una fila de la pantalla de Configuración. La pantalla es **manejada por
// datos**: Rust arma la lista (`Ide::settings_rows`) y `ide_settings.slint`
// elige el control según `kind`. Agregar un ajuste no toca el `.slint`.
//
//   kind : 0 texto · 1 booleano · 2 opción (ciclo) · 3 deslizador
//          4 acción (botón) · 5 contraseña · 6 informativo
//   scope: 0 global (todo el programa) · 1 del proyecto abierto
export struct IdeSetting {
    id: string,
    section: int,
    kind: int,
    label: string,
    value: string,
    hint: string,
    scope: int,
    num: float,
    min: float,
    max: float,
    step: float,
}

// Pestaña del editor.
export struct IdeTab {
    title: string,
    dirty: bool,
}

// Fragmento de código con su color.
// kind: 0 texto, 1 comentario, 2 keyword, 3 string, 4 número, 5 etiqueta.
export struct IdeToken {
    text: string,
    kind: int,
}

// Línea de código: indentación en píxeles + tokens (los espacios entre tokens
// van como tokens de solo-espacios para conservar el alineado monoespaciado).
export struct IdeCodeLine {
    indent: length,
    tokens: [IdeToken],
    // Marca de error del analizador (línea con diagnóstico).
    error: bool = false,
}

// Tramo de texto de la **terminal real**: celdas contiguas con el mismo frente,
// fondo y negrita. `col`/`cols` ubican el tramo en la grilla de celdas.
export struct TermRun {
    text: string,
    col: int,
    cols: int,
    fg: color,
    bg: color,
    bold: bool,
}

// Fila de la terminal real.
export struct TermLine {
    runs: [TermRun],
}

// Símbolo del esquema (outline): función (kind 0) o variable (kind 1).
export struct IdeOutlineItem {
    label: string,
    detail: string,
    line: int,
    kind: int,
}

// Entrada de "Recientes" de la bienvenida: proyecto (kind 1) o archivo (kind 0).
export struct IdeRecent {
    label: string,
    detail: string,
    kind: int,
}

// Archivo con cambios para el panel de control de código.
export struct IdeGitFile {
    // Estado de dos columnas (`M `, ` M`, `??`, `A `, …).
    status: string,
    // Nombre o ruta relativa (lo que se muestra).
    name: string,
    // Ruta relativa a la raíz (lo que recibe el callback).
    path: string,
}

// Fila de la paleta de comandos / buscador de archivos.
export struct IdePaletteItem {
    label: string,
    detail: string,
}

// Resultado de "buscar en el proyecto".
export struct IdeSearchHit {
    // Ruta relativa a la raíz.
    path: string,
    // Línea (1-based, para mostrar).
    line: int,
    // Texto de la línea.
    text: string,
}

// Línea de un diff. kind: 0 contexto, 1 agregada, 2 borrada, 3 encabezado de
// hunk (`@@`), 4 metadatos (`diff --git`, `index`, `---`, `+++`).
export struct IdeDiffLine {
    text: string,
    kind: int,
}

// Fila de Preferencias (ajuste o atajo).
export struct IdePrefRow {
    id: string,
    label: string,
    value: string,
}

// Fila de un menú desplegable (Archivo/Editar). `id` vacío = separador.
export struct IdeMenuEntry {
    id: string,
    label: string,
    detail: string,
    enabled: bool,
}

// --- Chat del agente (NuCoder) ---

// Línea de código de un mensaje. Reutiliza `IdeToken` para el resaltado de
// sintaxis (misma semántica de `kind` que el editor).
export struct IdeChatCodeLine {
    tokens: [IdeToken],
}

// Segmento de un mensaje del chat: prosa Markdown (`code: false`, se dibuja con
// `md`) o un bloque de código ya tokenizado (`code: true`, se dibuja con
// `lines` y la etiqueta `lang`).
export struct IdeChatSeg {
    code: bool,
    lang: string,
    md: styled-text,
    // Código crudo del bloque (para el botón «copiar»).
    raw: string,
    lines: [IdeChatCodeLine],
}

// Mensaje del chat.
//   role: 0 usuario · 1 asistente · 2 herramienta · 3 aviso · 4 error
export struct IdeChatMsg {
    role: int,
    title: string,
    // Markdown crudo del mensaje (para el botón «copiar»).
    text: string,
    segs: [IdeChatSeg],
}

// Modelo de chat para el selector del panel de NuCoder.
export struct IdeChatModel {
    id: string,
    label: string,
    free: bool,
    power: int,
    caps: string,
}

// Fila del listado de modelos (con especialidad y estado de ping).
// state: 0 sin probar · 1 probando · 2 ok · 3 error
export struct IdeModelRow {
    id: string,
    label: string,
    provider: string,
    specialty: string,
    free: bool,
    power: int,
    status: string,
    state: int,
    chat: bool,
    header: bool,
}

// Entrada remota del cliente FTP.
export struct IdeFtpEntry {
    name: string,
    dir: bool,
    size: string,
}
