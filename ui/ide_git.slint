import { IdeTheme } from "ide_theme.slint";
import { IdeGitFile } from "ide_types.slint";
import { DockHandle } from "ide_dock.slint";
import { TipContent } from "ide_tooltip.slint";

// Encabezado de sección (CAMBIOS / PREPARADOS).
component GitSection inherits Rectangle {
    in property <string> label: "";
    height: 20px;
    background: transparent;

    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: IdeTheme.text-dim;
        font-family: IdeTheme.sans;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.4px;
        vertical-alignment: center;
    }
}

// Botón compacto del panel (preparar, push, commit…).
component GitButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <string> tip: "";
    callback activated();

    height: 26px;
    width: label-text.width + 22px;
    border-radius: IdeTheme.radius-sm;
    background: !root.enabled ? IdeTheme.control
        : ta.has-hover ? (root.primary ? #9fe6d8 : IdeTheme.control-hi)
        : (root.primary ? IdeTheme.mint : IdeTheme.control);
    border-width: 1px;
    border-color: root.primary ? transparent : IdeTheme.border-soft;

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    label-text := Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? IdeTheme.bg : (root.enabled ? IdeTheme.text-soft : IdeTheme.text-dim);
        font-family: IdeTheme.sans;
        font-size: 11px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Fila de un archivo con cambios: estado, ruta y botón preparar/quitar.
component GitFileRow inherits Rectangle {
    in property <string> status: "";
    in property <string> name: "";
    in property <bool> staged: false;
    callback activated();
    callback toggle();

    height: 22px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? IdeTheme.control : transparent;

    Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        text: root.status;
        color: root.status == "??" ? IdeTheme.amber : (root.staged ? IdeTheme.add : IdeTheme.text-soft);
        font-family: IdeTheme.mono;
        font-size: 11px;
        vertical-alignment: center;
    }

    Text {
        x: 34px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 34px - 24px;
        text: root.name;
        color: ta.has-hover ? IdeTheme.text : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // Abrir el archivo (capa de abajo).
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }

    // Preparar/quitar del índice (capa de arriba, no abre el archivo).
    toggle-hit := TouchArea {
        x: parent.width - 22px;
        y: 0;
        width: 22px;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggle(); }

        Text {
            width: parent.width;
            height: parent.height;
            text: root.staged ? "−" : "+";
            color: toggle-hit.has-hover ? IdeTheme.mint : IdeTheme.text-dim;
            font-family: IdeTheme.sans;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Panel de control de código (Git) con rama, cambios y commit.
export component IdeGit inherits Rectangle {
    in property <string> branch: "";
    in property <bool> is-repo: false;
    in property <bool> busy: false;
    in property <string> note: "";
    in property <bool> error: false;
    // "↑2 ↓1" o vacío.
    in property <string> sync-info: "";
    in property <[IdeGitFile]> staged: [];
    in property <[IdeGitFile]> changes: [];
    // Mensaje del commit: en dos vías con la ventana (`<=>`).
    in-out property <string> message: "";

    callback refresh();
    callback init-repo();
    callback stage-all();
    callback unstage-all();
    callback toggle(string, bool);
    callback commit();
    callback amend();
    callback pull();
    callback push();
    callback branch-click();
    callback open-file(string);
    callback diff(string, bool, bool);

    background: IdeTheme.panel;
    // Opacidad de la superficie del panel (Preferencias → Opacidad).
    opacity: IdeTheme.panel-alpha;
    border-width: IdeTheme.hairline;
    border-color: transparent;
    border-radius: IdeTheme.radius;
    clip: true;

    private property <length> header-h: 32px;
    private property <length> footer-h: self.is-repo ? 120px : 0px;
    private property <length> body-h: max(0px, self.height - self.header-h - self.footer-h);

    // Ancla local del menú de ramas (la ventana la vuelve absoluta).
    out property <length> branch-menu-x: 12px;
    out property <length> branch-menu-y: self.header-h;

    // --- encabezado ---
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.header-h;
        background: transparent;

        // Asa para arrastrar el panel a otro dock (ver ui/ide_dock.slint).
        DockHandle {
            x: 0;
            y: 0;
            height: parent.height;
            panel: 3;
        }

        Text {
            x: 14px;
            y: (parent.height - self.height) / 2;
            text: @tr("CÓDIGO");
            color: IdeTheme.text-dim;
            font-family: IdeTheme.sans;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.6px;
            vertical-alignment: center;
        }

        // Rama (clickeable para cambiar) + ahead/behind.
        branch-text := Text {
            x: parent.width - 34px - self.width - 8px;
            y: (parent.height - self.height) / 2;
            text: root.branch;
            color: branch-hit.has-hover ? IdeTheme.text : IdeTheme.mint;
            font-family: IdeTheme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.sync-info != "": Text {
            x: branch-text.x - self.width - 8px;
            y: (parent.height - self.height) / 2;
            text: root.sync-info;
            color: IdeTheme.text-dim;
            font-family: IdeTheme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }

        branch-hit := TouchArea {
            x: branch-text.x - 4px;
            y: (parent.height - 20px) / 2;
            width: branch-text.width + 8px;
            height: 20px;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.branch-click(); }
        }

        refresh-hit := TouchArea {
            x: parent.width - 30px;
            y: (parent.height - 22px) / 2;
            width: 22px;
            height: 22px;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.refresh(); }

            Text {
                width: parent.width;
                height: parent.height;
                text: "⟳";
                color: refresh-hit.has-hover ? IdeTheme.text : IdeTheme.text-dim;
                font-family: IdeTheme.sans;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            y: parent.height - IdeTheme.hairline;
            width: parent.width;
            height: IdeTheme.hairline;
            background: IdeTheme.border-faint;
        }
    }

    // --- sin repositorio ---
    if !root.is-repo: VerticalLayout {
        x: 12px;
        y: root.header-h;
        width: parent.width - 24px;
        height: root.body-h;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 10px;

        Text {
            text: @tr("No es un repositorio Git");
            color: IdeTheme.text-soft;
            font-family: IdeTheme.sans;
            font-size: 12px;
            horizontal-alignment: center;
        }
        GitButton {
            label: @tr("Inicializar repositorio");
            primary: true;
            tip: @tr("Crear un repositorio Git nuevo en la raíz del proyecto (git init)");
            activated => { root.init-repo(); }
        }
    }

    // --- cambios ---
    if root.is-repo: Flickable {
        x: 0;
        y: root.header-h;
        width: parent.width;
        height: root.body-h;
        content-width: self.width;
        content-height: body.preferred-height + 8px;

        body := VerticalLayout {
            x: 0;
            y: 4px;
            width: parent.width - 12px;
            padding-left: 6px;
            spacing: 1px;

            if root.changes.length > 0: GitSection { label: @tr("CAMBIOS"); }
            for c[i] in root.changes: GitFileRow {
                status: c.status;
                name: c.name;
                staged: false;
                activated => { root.diff(c.path, false, c.status == "??"); }
                toggle => { root.toggle(c.path, false); }
            }

            if root.staged.length > 0: GitSection { label: @tr("PREPARADOS"); }
            for s[i] in root.staged: GitFileRow {
                status: s.status;
                name: s.name;
                staged: true;
                activated => { root.diff(s.path, true, false); }
                toggle => { root.toggle(s.path, true); }
            }

            if root.changes.length == 0 && root.staged.length == 0: Text {
                text: @tr("Sin cambios");
                color: IdeTheme.text-dim;
                font-family: IdeTheme.sans;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }

    // --- pie: mensaje + acciones ---
    if root.is-repo: Rectangle {
        x: 0;
        y: parent.height - root.footer-h;
        width: parent.width;
        height: root.footer-h;
        background: transparent;

        Rectangle {
            y: 0;
            width: parent.width;
            height: IdeTheme.hairline;
            background: IdeTheme.border-faint;
        }

        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 28px;
            border-radius: IdeTheme.radius-sm;
            background: IdeTheme.bg;
            border-width: 1px;
            border-color: IdeTheme.border-soft;

            commit-input := TextInput {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: parent.height;
                text <=> root.message;
                single-line: true;
                color: IdeTheme.text;
                font-family: IdeTheme.mono;
                font-size: 12px;
                vertical-alignment: center;
            }

            // Texto de ayuda cuando el campo está vacío.
            if root.message == "": Text {
                x: 8px;
                y: (parent.height - self.height) / 2;
                text: @tr("Mensaje del commit…");
                color: IdeTheme.text-dim;
                font-family: IdeTheme.mono;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            x: 8px;
            y: 42px;
            width: parent.width - 16px;
            height: 26px;
            spacing: 6px;
            alignment: start;
            cross-axis-alignment: center;

            GitButton {
                label: @tr("Preparar todo");
                enabled: !root.busy;
                tip: @tr("Preparar todos los cambios para el commit (git add -A)");
                activated => { root.stage-all(); }
            }
            GitButton {
                label: @tr("Quitar todo");
                enabled: !root.busy;
                tip: @tr("Quitar todos los archivos del índice (git reset)");
                activated => { root.unstage-all(); }
            }
        }

        HorizontalLayout {
            x: 8px;
            y: 74px;
            width: parent.width - 16px;
            height: 26px;
            spacing: 6px;
            alignment: start;
            cross-axis-alignment: center;

            GitButton {
                label: @tr("Bajar");
                enabled: !root.busy;
                tip: @tr("Traer cambios del remoto (git pull)");
                activated => { root.pull(); }
            }
            GitButton {
                label: @tr("Ramas");
                enabled: !root.busy;
                tip: @tr("Ver y cambiar de rama (git branch)");
                activated => { root.branch-click(); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            GitButton {
                label: @tr("Commit");
                primary: true;
                enabled: !root.busy && root.message != "";
                tip: @tr("Confirmar los cambios preparados (git commit)");
                activated => { root.commit(); }
            }
        }

        Text {
            x: 10px;
            y: 104px;
            width: parent.width - 20px;
            text: root.note;
            color: root.error ? IdeTheme.del : IdeTheme.text-dim;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
