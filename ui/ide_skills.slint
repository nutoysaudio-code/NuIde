import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";
import { IdeSkillRow } from "ide_types.slint";

// Botón compacto del modal (misma métrica que el resto de la IDE).
component SButton inherits Rectangle {
    in property <string> label: "";
    callback activated();

    width: text.width + 20px;
    height: 26px;
    border-radius: IdeTheme.radius-sm;
    background: hit.has-hover ? IdeTheme.control-hi : IdeTheme.control;

    Text {
        text := Text {
            x: 10px;
            y: (parent.height - self.height) / 2;
            text: root.label;
            color: IdeTheme.text;
            font-family: IdeTheme.sans;
            font-size: 11px;
        }
    }
    hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// ---------------------------------------------------------------------------
// Catálogo de skills (Claude / OpenCode / nativos) + hub.
//
// Lista con buscador en vivo, estado (anunciado/oculto/ask/deny) y acciones:
// anunciar/ocultar, cocinar (NuCook), instalar (repo/ruta) y eliminar. A la
// derecha, el detalle (la receta cocida o el cuerpo). El teclado del buscador
// lo maneja Rust (como los otros modales).
// ---------------------------------------------------------------------------

export component IdeSkills inherits Rectangle {
    in property <[IdeSkillRow]> rows: [];
    in property <int> selected: 0;
    in property <[string]> detail: [];
    in property <string> dir: "";
    in property <string> header: "";
    in property <string> filter: "";
    in property <string> note: "";
    in property <bool> busy: false;
    in property <bool> web: false;

    callback skill-selected(int);
    callback toggle();
    callback refresh();
    callback install-requested();
    callback update-requested();
    callback cook-requested();
    callback delete-requested();
    callback perm-cycle();
    callback catalog-requested();
    callback web-toggle();
    callback dismiss();

    // Etiqueta del permiso del skill seleccionado (state de `IdeSkillRow`).
    function perm-label(s: int) -> string {
        s == 0 ? @tr("anunciar")
            : s == 1 ? @tr("oculto")
            : s == 2 ? @tr("preguntar")
            : s == 3 ? @tr("bloquear")
            : @tr("web");
    }

    // Fondo que cierra al clic fuera.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;

        TouchArea {
            clicked => { root.dismiss(); }
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 56px;
        width: min(1040px, parent.width - 80px);
        height: min(640px, parent.height - 100px);
        background: IdeTheme.panel;
        border-width: 1px;
        border-color: IdeTheme.border-soft;
        border-radius: IdeTheme.radius;
        clip: true;

        // --- encabezado ---
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 40px;
            background: IdeTheme.bg;

            Text {
                x: 16px;
                y: (parent.height - self.height) / 2;
                text: @tr("Skills");
                color: IdeTheme.text;
                font-family: IdeTheme.sans;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                x: 68px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 620px;
                text: root.header;
                color: IdeTheme.text-soft;
                font-family: IdeTheme.mono;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-soft;
            }
        }

        // --- acciones ---
        Rectangle {
            x: 0;
            y: 40px;
            width: parent.width;
            height: 34px;
            background: IdeTheme.bg;

            HorizontalLayout {
                x: 12px;
                y: 4px;
                width: parent.width - 24px;
                height: 26px;
                spacing: 6px;
                alignment: start;
                cross-axis-alignment: center;

                SButton { label: @tr("Instalar…"); activated => { root.install-requested(); } }
                SButton { label: @tr("Actualizar"); activated => { root.update-requested(); } }
                SButton { label: @tr("Eliminar"); activated => { root.delete-requested(); } }
                SButton {
                    label: @tr("Permiso") + ": " + (root.selected < root.rows.length ? root.perm-label(root.rows[root.selected].state) : "—");
                    activated => { root.perm-cycle(); }
                }
                SButton { label: @tr("Cocinar"); activated => { root.cook-requested(); } }
                SButton { label: root.web ? @tr("web ✓") : @tr("web"); activated => { root.web-toggle(); } }
                SButton { label: @tr("Catálogo…"); activated => { root.catalog-requested(); } }
                SButton { label: @tr("Refrescar"); activated => { root.refresh(); } }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- buscador ---
        Rectangle {
            x: 0;
            y: 74px;
            width: parent.width;
            height: 28px;
            background: IdeTheme.bg;

            Text {
                x: 14px;
                y: (parent.height - self.height) / 2;
                text: @tr("buscar:");
                color: IdeTheme.text-dim;
                font-family: IdeTheme.mono;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                x: 66px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 300px;
                text: root.filter == "" ? @tr("(escribí para filtrar por id, nombre o descripción)")
                    : root.filter + "▎";
                color: root.filter == "" ? IdeTheme.text-dim : IdeTheme.text;
                font-family: IdeTheme.mono;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width - 228px;
                y: (parent.height - self.height) / 2;
                width: 214px;
                text: root.busy ? @tr("cocinando/instalando…") : root.note;
                color: root.busy ? IdeTheme.amber : IdeTheme.mint;
                font-family: IdeTheme.sans;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- lista ---
        Rectangle {
            x: 0;
            y: 102px;
            width: 380px;
            height: parent.height - 102px;
            background: transparent;

            Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: root.rows.length * 30px + 8px;

                for r[i] in root.rows: row := Rectangle {
                    height: 30px;
                    y: i * 30px + 4px;
                    width: parent.width;
                    background: root.selected == i ? IdeTheme.selection : (hit.has-hover ? IdeTheme.control : transparent);

                    Text {
                        x: 14px;
                        y: 5px;
                        width: parent.width - 96px;
                        text: r.id;
                        color: root.selected == i ? IdeTheme.text : IdeTheme.mint;
                        font-family: IdeTheme.mono;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        x: 14px;
                        y: 17px;
                        width: parent.width - 96px;
                        text: r.source + " · " + r.name;
                        color: IdeTheme.text-dim;
                        font-family: IdeTheme.sans;
                        font-size: 10px;
                        overflow: elide;
                    }
                    Text {
                        x: parent.width - 88px;
                        y: (parent.height - self.height) / 2;
                        width: 76px;
                        text: r.state == 0 ? @tr("anunciado")
                            : r.state == 1 ? @tr("oculto")
                            : r.state == 2 ? @tr("ask")
                            : r.state == 3 ? @tr("deny")
                            : @tr("web");
                        color: r.state == 0 ? IdeTheme.mint
                            : r.state == 2 ? IdeTheme.amber
                            : r.state == 3 ? IdeTheme.del
                            : IdeTheme.text-dim;
                        font-family: IdeTheme.sans;
                        font-size: 10px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    hit := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.skill-selected(i); }
                    }
                }
            }

            if root.rows.length == 0: Text {
                x: 14px;
                y: 12px;
                width: parent.width - 28px;
                text: @tr("(sin skills: probá «Instalar…» o «Refrescar»)");
                color: IdeTheme.text-dim;
                font-family: IdeTheme.sans;
                font-size: 11px;
            }

            Rectangle {
                x: parent.width - IdeTheme.hairline;
                y: 0;
                width: IdeTheme.hairline;
                height: parent.height;
                background: IdeTheme.border-faint;
            }
        }

        // --- detalle ---
        Rectangle {
            x: 380px;
            y: 102px;
            width: parent.width - 380px;
            height: parent.height - 102px;
            background: transparent;

            Text {
                x: 14px;
                y: 8px;
                width: parent.width - 28px;
                text: root.dir == "" ? @tr("Seleccioná un skill para ver su contenido") : root.dir;
                color: IdeTheme.text-dim;
                font-family: IdeTheme.mono;
                font-size: 10px;
                overflow: elide;
            }

            Flickable {
                x: 0;
                y: 28px;
                width: parent.width;
                height: parent.height - 28px;
                content-width: self.width;
                content-height: root.detail.length * 18px + 8px;

                for line[i] in root.detail: Rectangle {
                    height: 18px;
                    y: i * 18px;
                    width: parent.width;
                    Text {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        text: line;
                        color: IdeTheme.text-soft;
                        font-family: IdeTheme.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
