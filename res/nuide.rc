// Recursos de Windows para NuIde: icono y metadatos de versión.
// Se compilan con `rc.exe` (build.rs) sólo en builds MSVC y si la herramienta
// está disponible; si no, el `.exe` se compila igual, sin icono.

1 ICON "nuide.ico"

1 VERSIONINFO
FILEVERSION 0,2,2,0
PRODUCTVERSION 0,2,2,0
FILEOS 0x40004
FILETYPE 0x1
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040a04b0"
        {
            VALUE "CompanyName", "NuToys\0"
            VALUE "FileDescription", "NuIde - IDE multi-lenguaje con soporte de SpASM\0"
            VALUE "FileVersion", "0.2.2\0"
            VALUE "InternalName", "nuide\0"
            VALUE "OriginalFilename", "nuide.exe\0"
            VALUE "ProductName", "NuIde\0"
            VALUE "ProductVersion", "0.2.2\0"
            VALUE "LegalCopyright", "Copyright (C) NuToys\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x040a, 1200
    }
}
