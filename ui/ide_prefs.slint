import { IdeTheme } from "ide_theme.slint";
import { IdePrefRow } from "ide_types.slint";
import { TipContent } from "ide_tooltip.slint";

// Botón pequeño de Preferencias.
component PrefButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback activated();

    width: 22px;
    height: 22px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? IdeTheme.control-hi : IdeTheme.control;
    border-width: 1px;
    border-color: IdeTheme.border-soft;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? IdeTheme.mint : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Fila ajuste: etiqueta + valor clickeable.
component PrefRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback activated();

    height: 28px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? IdeTheme.control : transparent;

    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 10px - self.width;
        y: (parent.height - self.height) / 2;
        text: root.value;
        color: ta.has-hover ? IdeTheme.text : IdeTheme.mint;
        font-family: IdeTheme.mono;
        font-size: 11px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Encabezado de sección.
component PrefSection inherits Text {
    in property <string> title: "";
    text: root.title;
    color: IdeTheme.text-dim;
    font-family: IdeTheme.sans;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.4px;
    height: 22px;
    vertical-alignment: center;
}

// Panel de Preferencias.
export component IdePrefs inherits Rectangle {
    in property <string> mono: "";
    in property <string> sans: "";
    // Valor actual de la opacidad de los paneles ("100 %", "85 %", ...).
    in property <string> alpha: "";
    in property <string> editor-size: "12";
    in property <string> accent: "";
    in property <color> accent-color: #83d9cb;
    in property <string> tab-size: "4";
    in property <bool> insert-spaces: true;
    in property <bool> build-on-save: false;
    in property <[IdePrefRow]> keys: [];
    // Acción que está esperando una combinación de teclas ("" = ninguna).
    in property <string> capturing: "";

    // --- sitio de despliegue del proyecto abierto ---
    in property <string> site-transport: "FTP";
    in property <string> site-host: "";
    in property <string> site-user: "";
    in property <string> site-pass: "";
    in property <string> site-remote: "";
    in property <string> site-local-sub: "";
    in property <string> site-include: "";
    in property <string> site-script: "";

    // --- módulos opt-in ---
    // Servidor web local (se prende desde acá; la URL aparece en el pie).
    in property <bool> web-enabled: false;
    in property <string> web-port: "8080";
    in property <string> web-root: "";
    in property <string> web-cors: "*";
    // Visor de SQLite: prende el panel y muestra la base cargada.
    in property <bool> sqlite-module: false;
    in property <string> sqlite-db-name: "";

    callback toggle-web();
    callback edit-web-port();
    callback edit-web-root();
    callback edit-web-cors();
    callback toggle-sqlite();

    callback dismiss();
    callback cycle-mono();
    callback cycle-sans();
    callback cycle-alpha();
    callback font-smaller();
    callback font-bigger();
    callback cycle-accent();
    callback cycle-tab();
    callback toggle-spaces();
    callback toggle-build();
    callback capture(string);
    // Despliegue: ciclar transporte, editar un campo (el id del `Site`), probar,
    // subir y abrir la terminal SSH.
    callback cycle-transport();
    callback edit-site(string);
    callback test-site();
    callback upload-site();
    callback ssh-terminal();

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;

        backdrop := TouchArea {
            clicked => { root.dismiss(); }
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 48px;
        width: 560px;
        height: min(560px, parent.height - 80px);
        background: IdeTheme.panel;
        border-width: 1px;
        border-color: IdeTheme.border-soft;
        border-radius: IdeTheme.radius;
        clip: true;

        Text {
            x: 18px;
            y: (36px - self.height) / 2;
            text: @tr("Preferencias");
            color: IdeTheme.text;
            font-family: IdeTheme.sans;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            y: 36px;
            width: parent.width;
            height: IdeTheme.hairline;
            background: IdeTheme.border-faint;
        }

        Flickable {
            x: 0;
            y: 36px;
            width: parent.width;
            height: parent.height - 36px;
            content-width: self.width;
            content-height: prefs-list.preferred-height + 16px;

            prefs-list := VerticalLayout {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                spacing: 2px;
                alignment: start;

                PrefSection { title: @tr("APARIENCIA"); }
                PrefRow { label: @tr("Fuente del código"); value: root.mono; activated => { root.cycle-mono(); } }
                PrefRow { label: @tr("Fuente de la interfaz"); value: root.sans; activated => { root.cycle-sans(); } }
                PrefRow { label: @tr("Opacidad de los paneles"); value: root.alpha; activated => { root.cycle-alpha(); } }
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Text {
                        text: @tr("Tamaño del código");
                        color: IdeTheme.text-soft;
                        font-family: IdeTheme.sans;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    PrefButton { label: "−"; activated => { root.font-smaller(); } }
                    Text {
                        text: root.editor-size;
                        color: IdeTheme.mint;
                        font-family: IdeTheme.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                        width: 28px;
                        horizontal-alignment: center;
                    }
                    PrefButton { label: "+"; activated => { root.font-bigger(); } }
                }
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Text {
                        text: @tr("Acento");
                        color: IdeTheme.text-soft;
                        font-family: IdeTheme.sans;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 28px;
                        height: 16px;
                        border-radius: 3px;
                        background: root.accent-color;
                    }
                    Text {
                        text: root.accent;
                        color: IdeTheme.mint;
                        font-family: IdeTheme.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                PrefSection { title: @tr("EDITOR"); }
                PrefRow { label: @tr("Tamaño de tab"); value: root.tab-size; activated => { root.cycle-tab(); } }
                PrefRow { label: @tr("Insertar espacios"); value: root.insert-spaces ? "Sí" : "No"; activated => { root.toggle-spaces(); } }

                PrefSection { title: @tr("EJECUTAR"); }
                PrefRow { label: @tr("Compilar al guardar"); value: root.build-on-save ? "Sí" : "No"; activated => { root.toggle-build(); } }

                PrefSection { title: @tr("DESPLIEGUE (sitio de este proyecto)"); }
                PrefRow {
                    label: @tr("Transporte");
                    value: root.site-transport;
                    activated => { root.cycle-transport(); }
                    Tooltip { TipContent { text: @tr("FTP (21), FTPS (FTP + TLS, curl valida el certificado) o SFTP (SSH, 22)"); } }
                }
                PrefRow {
                    label: @tr("Host");
                    value: root.site-host == "" ? "sin configurar" : root.site-host;
                    activated => { root.edit-site("host"); }
                    Tooltip { TipContent { text: @tr("Servidor del sitio, ej. ftp.midominio.com"); } }
                }
                PrefRow {
                    label: @tr("Usuario");
                    value: root.site-user == "" ? "—" : root.site-user;
                    activated => { root.edit-site("user"); }
                    Tooltip { TipContent { text: @tr("Usuario de FTP/SFTP del hosting"); } }
                }
                PrefRow {
                    label: @tr("Contraseña");
                    value: root.site-pass == "" ? "—" : "••••••••";
                    activated => { root.edit-site("pass"); }
                    Tooltip { TipContent { text: @tr("Se guarda en el config de NuIde (%APPDATA%), indexada por proyecto: no toca el repositorio"); } }
                }
                PrefRow {
                    label: @tr("Carpeta remota");
                    value: root.site-remote == "" ? "—" : root.site-remote;
                    activated => { root.edit-site("remote"); }
                    Tooltip { TipContent { text: @tr("Ruta en el servidor donde cae el sitio, ej. public_html o /www/mi-sitio"); } }
                }
                PrefRow {
                    label: @tr("Subcarpeta local");
                    value: root.site-local-sub == "" ? "raíz del proyecto" : root.site-local-sub;
                    activated => { root.edit-site("local-sub"); }
                    Tooltip { TipContent { text: @tr("Qué carpeta del proyecto se sube, ej. build o dist (vacío = todo el proyecto)"); } }
                }
                PrefRow {
                    label: @tr("Extensiones");
                    value: root.site-include;
                    activated => { root.edit-site("include"); }
                    Tooltip { TipContent { text: @tr("Lista separada por coma de extensiones que se suben"); } }
                }
                PrefRow {
                    label: @tr("Script de despliegue");
                    value: root.site-script == "" ? "deploy.spasm (si existe)" : root.site-script;
                    activated => { root.edit-site("script"); }
                    Tooltip {
                        TipContent { text: @tr("Script SpASM que decide qué subir. Imprime líneas «UPLOAD <local> [<remota>]», «SKIP <local>», «LOG <texto>». Sin script se sube la subcarpeta filtrando por extensión."); }
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    PrefButton {
                        label: @tr("Probar conexión");
                        activated => { root.test-site(); }
                    }
                    PrefButton {
                        label: @tr("Subir cambios");
                        activated => { root.upload-site(); }
                    }
                    PrefButton {
                        label: @tr("Terminal SSH");
                        activated => { root.ssh-terminal(); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                PrefSection { title: @tr("MÓDULOS"); }
                PrefRow {
                    label: @tr("Servidor web local");
                    value: root.web-enabled ? "Activo" : "Apagado";
                    activated => { root.toggle-web(); }
                    Tooltip {
                        TipContent { text: @tr("Sirve la carpeta del proyecto en http://localhost:<puerto>/ con CORS, para ver el sitio antes de subirlo"); }
                    }
                }
                PrefRow {
                    label: @tr("Puerto");
                    value: root.web-port;
                    activated => { root.edit-web-port(); }
                    Tooltip { TipContent { text: @tr("Puerto local del servidor (1024-65535)"); } }
                }
                PrefRow {
                    label: @tr("Carpeta servida");
                    value: root.web-root == "" ? "raíz del proyecto" : root.web-root;
                    activated => { root.edit-web-root(); }
                    Tooltip { TipContent { text: @tr("Subcarpeta que se sirve, ej. build o dist (vacío = todo el proyecto)"); } }
                }
                PrefRow {
                    label: @tr("CORS: origen permitido");
                    value: root.web-cors;
                    activated => { root.edit-web-cors(); }
                    Tooltip {
                        TipContent { text: @tr("Access-Control-Allow-Origin. * para cualquier origen; un dominio concreto si la página manda credenciales"); }
                    }
                }
                PrefRow {
                    label: @tr("Visor de SQLite");
                    value: root.sqlite-module ? "Activo" : "Apagado";
                    activated => { root.toggle-sqlite(); }
                    Tooltip {
                        TipContent { text: @tr("Panel para mirar las tablas de una base .db del proyecto. Usa sqlite3.exe o Python, sin librerías extra"); }
                    }
                }
                PrefRow {
                    label: @tr("Base abierta");
                    value: root.sqlite-db-name == "" ? "ninguna (clic para elegir)" : root.sqlite-db-name;
                    activated => { root.toggle-sqlite(); }
                    Tooltip { TipContent { text: @tr("Elegí un archivo .db / .sqlite; el panel se abre en cuanto hay base"); } }
                }

                PrefSection { title: @tr("ATAJOS (clic para reasignar)"); }
                for key in root.keys: PrefRow {
                    label: key.label;
                    value: root.capturing == key.id ? "…" : key.value;
                    activated => { root.capture(key.id); }
                }
            }
        }

        // Aviso cuando se está capturando una combinación.
        if root.capturing != "": Rectangle {
            y: parent.height - 26px;
            width: parent.width;
            height: 26px;
            background: IdeTheme.control;
            Text {
                x: 12px;
                y: (parent.height - self.height) / 2;
                text: @tr("Presioná la combinación nueva (Esc para cancelar)");
                color: IdeTheme.amber;
                font-family: IdeTheme.sans;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
