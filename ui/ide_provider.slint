import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";
import { Palette, TextEdit } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Formulario de un proveedor de NuCoder (CRUD sobre su config propia
// `~/.config/nucoder/config.json`).
//
// La pantalla de Configuración maneja los proveedores como filas de acción
// ("editar" / "nuevo"); este diálogo edita los campos. Rust valida al guardar
// (el campo «Modelos» es un array JSON) y escribe la config de NuCoder.
// ---------------------------------------------------------------------------

// Botón del formulario.
component PBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <string> tip: "";
    callback activated();

    height: 30px;
    width: label-text.width + 30px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover
        ? (root.primary ? #9fe6d8 : (root.danger ? #d9a09fcc : IdeTheme.control-hi))
        : (root.primary ? IdeTheme.mint : (root.danger ? #d98c8c55 : IdeTheme.control));
    border-width: 1px;
    border-color: root.primary
        ? transparent
        : (root.danger ? #d98c8c77 : IdeTheme.border-soft);

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    label-text := Text {
        x: 15px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? IdeTheme.bg : (root.danger ? #e7b0b0 : IdeTheme.text-soft);
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Fila de campo de una línea (etiqueta + caja editable).
component PRow inherits Rectangle {
    in property <string> id: "";
    in property <string> label: "";
    in property <string> text: "";
    in property <bool> secret: false;
    in property <string> hint: "";
    callback changed(string, string);

    height: 30px;
    private property <string> buffer: root.text;

    Text {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 150px;
        text: root.label;
        color: IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }
    edit-box := Rectangle {
        x: 160px;
        y: 1px;
        width: parent.width - 160px;
        height: parent.height - 2px;
        border-radius: IdeTheme.radius-sm;
        background: IdeTheme.bg;
        border-width: 1px;
        border-color: edit.has-focus ? IdeTheme.mint : IdeTheme.border-soft;

        edit := TextInput {
            x: 8px;
            y: 0px;
            width: parent.width - 16px;
            height: parent.height;
            text <=> root.buffer;
            single-line: true;
            input-type: root.secret ? InputType.password : InputType.text;
            color: IdeTheme.text;
            font-family: IdeTheme.mono;
            font-size: 11px;
            vertical-alignment: center;
            edited() => { root.changed(root.id, root.buffer); }
            accepted => { root.changed(root.id, root.buffer); }
        }
    }
    if root.hint != "": Tooltip {
        TipContent { text: root.hint; }
    }
}

// Fila de interruptor (Sí/No) para un booleano.
component PToggle inherits Rectangle {
    in property <string> id: "";
    in property <string> label: "";
    in property <bool> on: false;
    in property <string> hint: "";
    callback changed(string, string);

    height: 30px;

    Text {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 150px;
        text: root.label;
        color: IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle {
        x: 160px;
        y: (parent.height - 22px) / 2;
        width: 64px;
        height: 22px;
        border-radius: 11px;
        background: root.on ? IdeTheme.mint : IdeTheme.control;
        border-width: 1px;
        border-color: root.on ? transparent : IdeTheme.border-soft;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.on ? @tr("Sí") : @tr("No");
            color: root.on ? IdeTheme.bg : IdeTheme.text-soft;
            font-family: IdeTheme.sans;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.changed(root.id, root.on ? "0" : "1"); }
        }
    }
    if root.hint != "": Tooltip {
        TipContent { text: root.hint; }
    }
}

// Área de «Modelos» como JSON crudo (texto de varias líneas).
component PModels inherits Rectangle {
    in property <string> text: "";
    callback changed(string, string);

    height: 168px;
    private property <string> buffer: root.text;

    Text {
        x: 0;
        y: 0;
        width: 150px;
        text: @tr("Modelos (JSON)");
        color: IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
    }
    area := Rectangle {
        x: 160px;
        y: 8px;
        width: parent.width - 160px;
        height: parent.height - 8px;
        border-radius: IdeTheme.radius-sm;
        background: IdeTheme.bg;
        border-width: 1px;
        border-color: IdeTheme.border-soft;
        clip: true;

        TextEdit {
            x: 2px;
            y: 2px;
            width: parent.width - 26px;
            height: parent.height - 4px;
            text <=> root.buffer;
            font-family: IdeTheme.mono;
            font-size: 11px;
            wrap: no-wrap;
            edited(text) => { root.changed("models", text); }
        }
    }
}

export component IdeProvider inherits FocusScope {
    in property <string> field-id: "";
    in property <string> field-name: "";
    in property <bool> field-free-only: false;
    in property <string> field-base-url: "";
    in property <string> field-api-key: "";
    in property <string> field-models: "";
    in property <bool> is-new: true;
    in property <string> note: "";
    callback changed(string, string);
    callback save();
    callback delete();
    callback cancel();

    init => {
        // El único std-widget de la app: forzamos el esquema oscuro para que el
        // editor de modelos no desentone con el resto de la interfaz.
        Palette.color-scheme = ColorScheme.dark;
    }

    focus-on-click: true;

    key-pressed(event) => {
        // Esc cierra el formulario (los campos ya se persisten al guardar).
        if event.text == "\u{1b}" {
            root.cancel();
            accept
        } else {
            reject
        }
    }

    // Fondo que cierra al clic fuera.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000bb;

        TouchArea {
            clicked => { root.cancel(); }
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 660px;
        height: min(560px, parent.height - 80px);
        background: IdeTheme.panel;
        border-width: 1px;
        border-color: IdeTheme.border-soft;
        border-radius: IdeTheme.radius;
        clip: true;

        // --- encabezado ---
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 52px;
            background: IdeTheme.bg;

            Text {
                x: 20px;
                y: 10px;
                text: @tr("Proveedor de NuCoder");
                color: IdeTheme.text;
                font-family: IdeTheme.sans;
                font-size: 16px;
                font-weight: 700;
                letter-spacing: 0.4px;
            }
            Text {
                x: 20px;
                y: 31px;
                text: @tr("Config propia · ~/.config/nucoder/config.json");
                color: IdeTheme.text-dim;
                font-family: IdeTheme.sans;
                font-size: 10px;
            }
            close-btn := Rectangle {
                x: parent.width - 46px;
                y: 13px;
                width: 26px;
                height: 26px;
                border-radius: IdeTheme.radius-sm;
                background: close-hit.has-hover ? #d98c8c33 : IdeTheme.control;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: IdeTheme.text;
                    font-family: IdeTheme.sans;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-hit := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.cancel(); }
                }
                Tooltip { TipContent { text: @tr("Cerrar (Esc)"); } }
            }
            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-soft;
            }
        }

        // --- campos ---
        VerticalLayout {
            x: 24px;
            y: 64px;
            width: parent.width - 48px;
            spacing: 10px;

            PRow {
                id: "id";
                label: @tr("ID");
                text: root.field-id;
                hint: "Clave del proveedor en la config (renombra si lo cambiás)";
                changed(i, v) => { root.changed(i, v); }
            }
            PRow {
                id: "name";
                label: @tr("Nombre");
                text: root.field-name;
                changed(i, v) => { root.changed(i, v); }
            }
            PToggle {
                id: "free-only";
                label: @tr("Sólo gratis");
                on: root.field-free-only;
                hint: "Ofrecer sólo los modelos gratuitos de este proveedor";
                changed(i, v) => { root.changed(i, v); }
            }
            PRow {
                id: "base-url";
                label: @tr("baseURL");
                text: root.field-base-url;
                changed(i, v) => { root.changed(i, v); }
            }
            PRow {
                id: "api-key";
                label: @tr("apiKey");
                secret: true;
                text: root.field-api-key;
                hint: "Puede quedar vacía si el proveedor usa variables de entorno (env)";
                changed(i, v) => { root.changed(i, v); }
            }
            PModels {
                text: root.field-models;
                changed(i, v) => { root.changed(i, v); }
            }
        }

        // --- nota de error ---
        if root.note != "": Text {
            x: 24px;
            y: parent.height - 58px;
            width: parent.width - 48px;
            text: root.note;
            color: #e8a0a0;
            font-family: IdeTheme.sans;
            font-size: 11px;
            wrap: word-wrap;
        }

        // --- botones ---
        HorizontalLayout {
            x: 24px;
            y: parent.height - 46px;
            width: parent.width - 48px;
            spacing: 8px;
            alignment: end;

            PBtn {
                label: @tr("Cancelar");
                activated => { root.cancel(); }
            }
            if !root.is-new: PBtn {
                label: @tr("Eliminar");
                danger: true;
                tip: @tr("Pide confirmación y saca el proveedor de la config de NuCoder");
                activated => { root.delete(); }
            }
            PBtn {
                label: @tr("Guardar");
                primary: true;
                tip: @tr("Valida los campos y escribe la config de NuCoder");
                activated => { root.save(); }
            }
        }
    }
}
