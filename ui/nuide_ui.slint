import { IdeTheme } from "ide_theme.slint";
export { IdeTheme }
import { IdeTreeNode, IdeTab, IdeCodeLine, TermLine, IdeOutlineItem, IdeRecent } from "ide_types.slint";
import { IdeTopBar } from "ide_topbar.slint";
import { IdeStatusBar } from "ide_statusbar.slint";
import { IdeExplorer } from "ide_explorer.slint";
import { IdeEditor } from "ide_editor.slint";
import { IdeTerminal } from "ide_terminal.slint";
import { IdeOpenCode } from "ide_opencode.slint";
import { IdeViewMenu } from "ide_viewmenu.slint";

// ---------------------------------------------------------------------------
// NuIde — SpASM Studio (walking skeleton)
//
// Monta el layout de la especificación: barra superior, tres columnas
// (explorador / editor + terminal / OpenCode CLI) con divisores arrastrables, y
// barra inferior de estado. Los datos de archivos, código y terminales son
// ilustrativos (ver docs/NUIDE_IDEA.md): sirven para iterar la UI sin motor.
//
// Los divisores se arrastran con un único `TouchArea` estacionario detrás de
// los paneles: al no moverse, `mouse-x`/`mouse-y` son coordenadas estables del
// área de contenido. Los huecos de 6 px entre paneles son la zona sensible.
// ---------------------------------------------------------------------------

export component NuIdeWindow inherits Window {
    title: "NuIde — SpASM Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 640px;
    background: IdeTheme.bg;

    // Reparto de espacio (fracciones) y modo de arrastre activo.
    in-out property <float> left-frac: 0.18;
    in-out property <float> right-frac: 0.28;
    in-out property <float> bottom-frac: 0.25;
    in-out property <int> drag-mode: 0;

    // Paneles visibles y estado del menú "Ver". Los maneja Rust.
    in-out property <bool> show-left: true;
    in-out property <bool> show-right: true;
    in-out property <bool> show-bottom: true;
    // Dock de cada panel: 0 izquierda, 1 derecha, 2 abajo, 3 oculto.
    in-out property <int> dock-explorer: 0;
    in-out property <int> dock-agent: 1;
    in-out property <int> dock-terminal: 2;
    in-out property <bool> view-open: false;

    // Selección de la UI (índices, no modelos reconstruidos).
    in-out property <int> explorer-selected: 2;
    in-out property <int> active-tab: 0;
    in-out property <int> active-session: 0;

    // Proyecto y editor reales.
    in-out property <string> project-name: "coquito";
    in-out property <int> active-line: 1;
    in-out property <int> active-column: 1;
    // Lenguaje del archivo activo (barra de estado).
    in-out property <string> language: "SpASM";
    // Visores: imagen y vista previa de Markdown.
    in-out property <bool> show-image: false;
    in-out property <image> active-image;
    in-out property <float> image-zoom: 1.0;
    in-out property <bool> show-preview: false;
    in-out property <styled-text> preview-styled;
    in-out property <bool> is-markdown: false;
    // Esquema de símbolos del archivo activo.
    in-out property <[IdeOutlineItem]> outline: [];
    // Pantalla de bienvenida del editor.
    in-out property <bool> welcome: false;
    // Recientes de la bienvenida (proyectos y archivos).
    in-out property <[IdeRecent]> welcome-recent: [];
    // Diagnóstico de SpASM (vacío si no hay errores).
    in-out property <string> diagnostics: "";

    // Búsqueda del editor.
    in-out property <bool> find-open: false;
    in-out property <bool> find-replace-open: false;
    in-out property <string> find-query: "";
    in-out property <string> find-replace: "";
    in-out property <string> find-info: "";
    in-out property <bool> find-focus-replace: false;
    in-out property <bool> find-case: false;
    in-out property <bool> find-whole-word: false;
    in-out property <string> find-query-before: "";
    in-out property <string> find-query-after: "";
    in-out property <string> find-replace-before: "";
    in-out property <string> find-replace-after: "";

    // Panel del agente (OpenCode CLI): estado y scrollback.
    in-out property <bool> agent-connected: false;
    in-out property <string> agent-version: "OpenCode CLI";
    in-out property <string> agent-model: "por defecto";
    in-out property <int> agent-scroll-total: 0;
    in-out property <float> agent-scroll-pos: 1.0;
    in-out property <float> agent-scroll-thumb: 1.0;

    // Terminal real: estado del scrollback (lo llena Rust).
    in-out property <int> term-scroll-total: 0;
    in-out property <float> term-scroll-pos: 1.0;
    in-out property <float> term-scroll-thumb: 1.0;
    // Vista dividida de la terminal.
    in-out property <bool> term-split: false;
    in-out property <[TermLine]> term-lines-2: [];

    callback menu-activated(string);
    callback close-requested();
    callback open-project();
    callback open-file();
    callback new-file();
    callback open-recent(int);
    callback terminal-key(string, bool, bool, bool);
    callback terminal-resize(length, length);
    callback terminal-scroll(length);
    callback terminal-selection-start(length, length);
    callback terminal-selection-update(length, length);
    callback terminal-selection-end();
    callback session-selected(int);
    callback new-session();
    callback close-session();
    callback split-terminal();
    callback terminal-focus-pane(int);
    // Menú "Ver": mostrar/ocultar regiones y cambiar el dock de cada panel.
    callback toggle-region(int);
    callback cycle-dock(int);
    callback view-menu-close();
    // Explorador y editor.
    callback node-activated(int);
    callback tab-activated(int);
    callback tab-closed(int);
    callback editor-key(string, bool, bool);
    callback editor-cursor(length, length, length);
    callback editor-extend(length, length, length);
    // Búsqueda del editor.
    callback find-next();
    callback find-prev();
    callback find-close();
    callback find-toggle-replace();
    callback find-toggle-case();
    callback find-toggle-word();
    callback find-focus(bool);
    callback replace-one();
    callback replace-all();
    // Vista previa de Markdown.
    callback preview-toggle();
    // Zoom del visor de imagen.
    callback image-zoom-in();
    callback image-zoom-out();
    callback image-zoom-reset();
    // Esquema: saltar a una línea.
    callback goto-line(int);
    // Panel del agente.
    callback agent-key(string, bool, bool, bool);
    callback agent-resize(length, length);
    callback agent-scroll(length);
    callback agent-selection-start(length, length);
    callback agent-selection-update(length, length);
    callback agent-selection-end();

    // La terminal recibe el teclado apenas se abre la ventana: sólo hay un
    // elemento focusable y éste es el dueño natural del foco.
    forward-focus: terminal;

    // Mide el ancho real de una celda monoespaciada (32 'M' a 12 px). Se usa
    // para dimensionar el PTY y ubicar la grilla de las terminales.
    measure := Text {
        x: -1000px;
        y: 0;
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: IdeTheme.mono;
        font-size: 12px;
        width: self.preferred-width;
        height: self.preferred-height;
        opacity: 0;
    }
    // La barra superior publica el ancho real de una celda monoespaciada
    // (medido en `measure`); Rust lo lee para dimensionar el PTY.
    out property <length> cell-width: measure.width > 1px ? measure.width / 32 : 7.2px;

    // --- geometría derivada (todo relativo al área de contenido) ---
    private property <length> view-menu-x: topbar.view-menu-x;
    private property <length> content-w: self.width;
    private property <length> content-h: max(0px, self.height - IdeTheme.topbar-h - IdeTheme.statusbar-h);

    // Cada panel tiene un dock (0 izquierda, 1 derecha, 2 abajo, 3 oculto) y los
    // que comparten región se apilan en el orden 0 Explorador, 1 OpenCode,
    // 2 Terminal.
    function dock-of(panel: int) -> int {
        return panel == 0 ? root.dock-explorer : panel == 1 ? root.dock-agent : root.dock-terminal;
    }
    function count-in(region: int) -> int {
        return (root.dock-explorer == region ? 1 : 0)
             + (root.dock-agent == region ? 1 : 0)
             + (root.dock-terminal == region ? 1 : 0);
    }
    function index-in(region: int, panel: int) -> int {
        return (panel > 0 && root.dock-explorer == region ? 1 : 0)
             + (panel > 1 && root.dock-agent == region ? 1 : 0);
    }
    function region-shown(region: int) -> bool {
        return region == 0 ? root.show-left : region == 1 ? root.show-right : root.show-bottom;
    }
    function region-visible(region: int) -> bool {
        return root.count-in(region) > 0 && root.region-shown(region);
    }
    function panel-visible(panel: int) -> bool {
        let dock = root.dock-of(panel);
        return dock != 3 && root.region-visible(dock);
    }
    function slot-h(region: int) -> length {
        let n = root.count-in(region);
        if (n <= 0) { return 0px; }
        return (region == 2 ? root.bottom-h : root.content-h) / n;
    }
    function slot-y(region: int, panel: int) -> length {
        let n = root.count-in(region);
        let base = region == 2 ? root.editor-h + root.bottom-gap : 0px;
        if (n <= 0) { return base; }
        return base + (root.index-in(region, panel) * (region == 2 ? root.bottom-h : root.content-h)) / n;
    }
    function panel-x(panel: int) -> length {
        let dock = root.dock-of(panel);
        return dock == 0 ? 0px : dock == 1 ? root.content-w - root.right-w : root.center-x;
    }
    function panel-w(panel: int) -> length {
        let dock = root.dock-of(panel);
        return dock == 0 ? root.left-w : dock == 1 ? root.right-w : root.center-w;
    }

    private property <length> left-w: root.region-visible(0) ? root.content-w * root.left-frac : 0px;
    private property <length> right-w: root.region-visible(1) ? root.content-w * root.right-frac : 0px;
    private property <length> left-gap: root.region-visible(0) ? IdeTheme.splitter : 0px;
    private property <length> right-gap: root.region-visible(1) ? IdeTheme.splitter : 0px;
    private property <length> center-x: root.left-w + root.left-gap;
    private property <length> center-w: max(0px, root.content-w - root.left-w - root.right-w - root.left-gap - root.right-gap);
    private property <length> editor-h: root.region-visible(2) ? root.content-h * (1 - root.bottom-frac) : root.content-h;
    private property <length> bottom-gap: root.region-visible(2) ? IdeTheme.splitter : 0px;
    private property <length> bottom-h: max(0px, root.content-h - root.editor-h - root.bottom-gap);

    // Qué divisor está bajo el cursor: 0 nada, 1 izquierda, 2 derecha, 3 horizontal.
    // Un divisor sólo cuenta si su región está visible.
    function hit-test(px: length, py: length) -> int {
        if (root.region-visible(0) && px >= root.left-w - 3px && px <= root.left-w + IdeTheme.splitter + 3px) {
            return 1;
        }
        if (root.region-visible(1) && px >= root.content-w - root.right-w - IdeTheme.splitter - 3px && px <= root.content-w - root.right-w + 3px) {
            return 2;
        }
        if (root.region-visible(2) && py >= root.editor-h - 3px && py <= root.editor-h + IdeTheme.splitter + 3px
            && px >= root.center-x && px <= root.center-x + root.center-w) {
            return 3;
        }
        return 0;
    }

    function apply-drag(px: length, py: length) {
        if (root.drag-mode == 1) {
            root.left-frac = min(max(px / root.content-w, 0.10), 0.40);
        } else if (root.drag-mode == 2) {
            root.right-frac = min(max((root.content-w - px) / root.content-w, 0.15), 0.45);
        } else if (root.drag-mode == 3) {
            root.bottom-frac = min(max(1 - py / root.content-h, 0.12), 0.50);
        }
    }

    // --- barra superior ---
    topbar := IdeTopBar {
        x: 0;
        y: 0;
        width: parent.width;
        project: root.project-name;
        view-active: root.view-open;
        show-left: root.show-left;
        show-right: root.show-right;
        show-bottom: root.show-bottom;
        menu-activated(label) => { root.menu-activated(label); }
        toggle-region(kind) => { root.toggle-region(kind); }
        project-clicked => { root.open-project(); }
        close-requested => { root.close-requested(); }
    }

    // --- barra inferior ---
    IdeStatusBar {
        x: 0;
        y: parent.height - IdeTheme.statusbar-h;
        width: parent.width;
        branch: "main";
        language: root.language;
        encoding: "UTF-8";
        line: root.active-line;
        column: root.active-column;
        diagnostics: root.diagnostics;
    }

    // --- área de contenido ---
    Rectangle {
        x: 0;
        y: IdeTheme.topbar-h;
        width: parent.width;
        height: root.content-h;
        background: IdeTheme.bg;

        // Zona sensible de los divisores (detrás de los paneles).
        drag := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.drag-mode = root.hit-test(self.mouse-x, self.mouse-y);
                    root.apply-drag(self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-mode = 0;
                }
            }

            moved => { root.apply-drag(self.mouse-x, self.mouse-y); }

            mouse-cursor: root.hit-test(self.mouse-x, self.mouse-y) == 3 ? MouseCursor.ns-resize
                : root.hit-test(self.mouse-x, self.mouse-y) != 0 ? MouseCursor.ew-resize
                : MouseCursor.default;

            // Guías visuales de los divisores (viven en los huecos entre paneles).
            // Sólo se ven si el panel que dividen está presente.
            Rectangle {
                x: root.left-w + IdeTheme.splitter / 2 - 1px;
                y: 0;
                width: 2px;
                height: root.content-h;
                visible: root.region-visible(0);
                background: root.drag-mode == 1 ? IdeTheme.mint : IdeTheme.border-soft;
            }
            Rectangle {
                x: root.content-w - root.right-w - IdeTheme.splitter / 2 - 1px;
                y: 0;
                width: 2px;
                height: root.content-h;
                visible: root.region-visible(1);
                background: root.drag-mode == 2 ? IdeTheme.mint : IdeTheme.border-soft;
            }
            Rectangle {
                x: root.center-x;
                y: root.editor-h + IdeTheme.splitter / 2 - 1px;
                width: root.center-w;
                height: 2px;
                visible: root.region-visible(2);
                background: root.drag-mode == 3 ? IdeTheme.mint : IdeTheme.border-soft;
            }
        }

        // --- panel: explorador (dock configurable) ---
        IdeExplorer {
            x: root.panel-x(0);
            y: root.slot-y(root.dock-of(0), 0);
            width: root.panel-w(0);
            height: root.slot-h(root.dock-of(0));
            visible: root.panel-visible(0);
            nodes: root.tree-nodes;
            selected-index: root.explorer-selected;
            node-clicked(i) => { root.explorer-selected = i; root.node-activated(i); editor.focus(); }
        }

        // --- columna central: editor ---
        editor := IdeEditor {
            x: root.center-x;
            y: 0;
            width: root.center-w;
            height: root.editor-h;
            tabs: root.editor-tabs;
            active-tab: root.active-tab;
            breadcrumb: root.breadcrumb;
            lines: root.code-lines;
            active-line: root.active-line;
            find-open: root.find-open;
            find-replace-open: root.find-replace-open;
            find-query: root.find-query;
            find-replace: root.find-replace;
            find-info: root.find-info;
            find-focus-replace: root.find-focus-replace;
            find-case: root.find-case;
            find-whole-word: root.find-whole-word;
            find-query-before: root.find-query-before;
            find-query-after: root.find-query-after;
            find-replace-before: root.find-replace-before;
            find-replace-after: root.find-replace-after;
            show-image: root.show-image;
            active-image: root.active-image;
            image-zoom: root.image-zoom;
            show-preview: root.show-preview;
            preview-styled: root.preview-styled;
            is-markdown: root.is-markdown;
            outline: root.outline;
            welcome: root.welcome;
            welcome-recent: root.welcome-recent;
            tab-selected(i) => { root.tab-activated(i); }
            tab-closed(i) => { root.tab-closed(i); }
            key-input(text, ctrl, shift) => { root.editor-key(text, ctrl, shift); }
            cursor-to(y, x, scroll) => { root.editor-cursor(y, x, scroll); }
            extend-to(y, x, scroll) => { root.editor-extend(y, x, scroll); }
            find-next => { root.find-next(); }
            find-prev => { root.find-prev(); }
            find-close => { root.find-close(); }
            find-toggle-replace => { root.find-toggle-replace(); }
            find-toggle-case => { root.find-toggle-case(); }
            find-toggle-word => { root.find-toggle-word(); }
            find-focus(replace) => { root.find-focus(replace); }
            replace-one => { root.replace-one(); }
            replace-all => { root.replace-all(); }
            preview-toggle => { root.preview-toggle(); }
            image-zoom-in => { root.image-zoom-in(); }
            image-zoom-out => { root.image-zoom-out(); }
            image-zoom-reset => { root.image-zoom-reset(); }
            goto-line(line) => { root.goto-line(line); }
            open-project => { root.open-project(); }
            open-file => { root.open-file(); }
            new-file => { root.new-file(); }
            open-recent(i) => { root.open-recent(i); }
        }

        // --- panel: terminal local (dock configurable) ---
        terminal := IdeTerminal {
            x: root.panel-x(2);
            y: root.slot-y(root.dock-of(2), 2);
            width: root.panel-w(2);
            height: root.slot-h(root.dock-of(2));
            visible: root.panel-visible(2);
            sessions: root.term-sessions;
            active-session: root.active-session;
            lines: root.term-lines;
            scroll-total: root.term-scroll-total;
            scroll-pos: root.term-scroll-pos;
            scroll-thumb: root.term-scroll-thumb;
            cell-width: root.cell-width;
            split-view: root.term-split;
            lines-2: root.term-lines-2;
            focus-pane(p) => { root.terminal-focus-pane(p); }
            session-selected(i) => { root.session-selected(i); }
            key-input(text, ctrl, shift, alt) => { root.terminal-key(text, ctrl, shift, alt); }
            resized(w, h) => { root.terminal-resize(w, h); }
            scrolled(dy) => { root.terminal-scroll(dy); }
            selection-start(y, x) => { root.terminal-selection-start(y, x); }
            selection-update(y, x) => { root.terminal-selection-update(y, x); }
            selection-end => { root.terminal-selection-end(); }
            new-session => { root.new-session(); }
            close => { root.close-session(); }
            split => { root.split-terminal(); }
        }

        // --- panel: OpenCode CLI (dock configurable) ---
        IdeOpenCode {
            x: root.panel-x(1);
            y: root.slot-y(root.dock-of(1), 1);
            width: root.panel-w(1);
            height: root.slot-h(root.dock-of(1));
            visible: root.panel-visible(1);
            connected: root.agent-connected;
            version: root.agent-version;
            model: root.agent-model;
            project: root.project-name;
            lines: root.agent-lines;
            scroll-total: root.agent-scroll-total;
            scroll-pos: root.agent-scroll-pos;
            scroll-thumb: root.agent-scroll-thumb;
            cell-width: root.cell-width;
            key-input(text, ctrl, shift, alt) => { root.agent-key(text, ctrl, shift, alt); }
            resized(w, h) => { root.agent-resize(w, h); }
            scrolled(dy) => { root.agent-scroll(dy); }
            selection-start(y, x) => { root.agent-selection-start(y, x); }
            selection-update(y, x) => { root.agent-selection-update(y, x); }
            selection-end => { root.agent-selection-end(); }
        }
    }

    // --- capa que cierra el menú "Ver" al hacer clic fuera ---
    if root.view-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.view-menu-close(); }
        }
    }

    // --- menú desplegable del ítem "Ver" ---
    if root.view-open: IdeViewMenu {
        x: root.view-menu-x;
        y: IdeTheme.topbar-h;
        dock-explorer: root.dock-explorer;
        dock-agent: root.dock-agent;
        dock-terminal: root.dock-terminal;
        cycle-dock(kind) => { root.cycle-dock(kind); }
    }

    // =======================================================================
    // Datos ilustrativos
    // =======================================================================

    in property <[IdeTreeNode]> tree-nodes: [
        { depth: 0, label: "coquito", kind: 2 },
        { depth: 1, label: "src", kind: 2 },
        { depth: 2, label: "main.spasm", kind: 0 },
        { depth: 2, label: "memory.spasm", kind: 0 },
        { depth: 1, label: "runtime", kind: 2 },
        { depth: 2, label: "memory.spasm", kind: 0 },
        { depth: 2, label: "io.spasm", kind: 0 },
        { depth: 1, label: "ui", kind: 2 },
        { depth: 2, label: "app.slint", kind: 0 },
        { depth: 1, label: "examples", kind: 1 },
        { depth: 2, label: "hello.spasm", kind: 0 },
        { depth: 2, label: "demo.spasm", kind: 0 },
        { depth: 1, label: "config.toml", kind: 3 },
    ];

    in property <[IdeTab]> editor-tabs: [];

    in property <[string]> breadcrumb: ["src", "main.spasm"];

    // La llena Rust al abrir archivos; la bienvenida se dibuja aparte.
    in property <[IdeCodeLine]> code-lines: [];

    in property <[string]> term-sessions: ["bash", "build"];

    // La pantalla real la llena Rust; arranca vacía.
    in property <[TermLine]> term-lines: [];

    // La TUI del agente también la llena Rust.
    in property <[TermLine]> agent-lines: [];
}
