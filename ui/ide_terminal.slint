import { IdeTheme } from "ide_theme.slint";
import { TermLine } from "ide_types.slint";
import { DockHandle } from "ide_dock.slint";
import { TipContent } from "ide_tooltip.slint";

// Botón compacto de encabezado (nuevo, cerrar, dividir…).
export component IdeHeaderButton inherits Rectangle {
    in property <string> glyph: "+";
    in property <bool> danger: false;
    in property <bool> split: false;
    // Qué hace el botón (el glifo solo no se entiende).
    in property <string> tip: "";
    callback activated();

    width: 22px;
    height: 22px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? (root.danger ? #d98c8c33 : IdeTheme.control) : transparent;

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    // Icono de "dividir": rectángulo con una línea media (no depende de glifos).
    if root.split: Rectangle {
        x: (parent.width - 11px) / 2;
        y: (parent.height - 11px) / 2;
        width: 11px;
        height: 11px;
        border-width: 1px;
        border-color: ta.has-hover ? IdeTheme.text : IdeTheme.text-soft;
        border-radius: 2px;
        background: transparent;

        Rectangle {
            y: 4px;
            width: parent.width;
            height: 1px;
            background: ta.has-hover ? IdeTheme.text : IdeTheme.text-soft;
        }
    }

    if !root.split: Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        color: ta.has-hover ? (root.danger ? IdeTheme.del : IdeTheme.text) : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Pestaña de sesión de terminal.
component IdeTermSession inherits Rectangle {
    in property <string> label: "bash";
    in property <bool> active: false;
    callback activated();

    height: 30px;
    width: sess-text.width + 26px;

    Tooltip {
        TipContent { text: "Sesión " + root.label + " — clic para pasar a ella"; }
    }

    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? IdeTheme.mint : transparent;
    }

    sess-text := Text {
        x: 13px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.active ? IdeTheme.text : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 11px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Pantalla de la terminal real: filas de tramos coloreados en monoespaciada.
// Cada tramo pinta su fondo; el cursor ya viene invertido desde Rust.
export component TerminalScreen inherits Rectangle {
    in property <[TermLine]> lines: [];
    in property <length> row-height: 16px;
    // Ancho real de una celda monoespaciada (lo mide la ventana).
    in property <length> cell-width: 7.2px;
    in property <int> scroll-total: 0;
    // Posición de la vista: 0 = lo más viejo del historial, 1 = final.
    in property <float> scroll-pos: 1.0;
    // Alto de la barra como fracción de la pista.
    in property <float> scroll-thumb: 1.0;
    // La app pidió mouse reporting: reenviamos los eventos en vez de seleccionar.
    in property <bool> mouse-tracking: false;
    // Pegar el portapapeles (botón del medio).
    callback paste-requested();
    callback selection-start(length, length);
    callback selection-update(length, length);
    callback selection-end();
    callback scrolled(length);
    // Evento de mouse: (kind, button, y, x). kind: 0 apretar, 1 soltar,
    // 2 mover, 3 rueda arriba, 4 rueda abajo. button: 0 izq, 1 medio, 2 der.
    callback mouse-report(int, int, length, length);

    function button-code(b: PointerEventButton) -> int {
        return b == PointerEventButton.left ? 0
            : b == PointerEventButton.middle ? 1
            : b == PointerEventButton.right ? 2
            : 3;
    }

    clip: true;
    background: transparent;

    // Grilla exacta: cada tramo se ubica por su columna, así los glifos de caja
    // y bloque de las TUI no se corren aunque la fuente no sea monoespaciada
    // perfecta.
    for line[i] in root.lines: Rectangle {
        y: i * root.row-height;
        width: parent.width;
        height: root.row-height;
        clip: true;

        for run in line.runs: Rectangle {
            x: run.col * root.cell-width;
            width: run.cols * root.cell-width;
            height: parent.height;
            background: run.bg;
            clip: true;

            Text {
                text: run.text;
                color: run.fg;
                font-family: IdeTheme.mono;
                font-size: 12px;
                font-weight: run.bold ? 700 : 400;
                height: parent.height;
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }
    }

    // Selección de texto con el mouse + rueda para el scrollback. Va por encima
    // de las filas; el teclado lo sigue manejando `IdeTerminal`.
    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            // El botón del medio pega el portapapeles (convención de terminal),
            // con o sin mouse reporting.
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                root.paste-requested();
            } else if (root.mouse-tracking && !event.modifiers.shift) {
                // Con mouse reporting el proceso se queda con el mouse. **Shift**
                // lo libera: así se puede seleccionar, y al soltar se copia
                // (convención de Windows Terminal / xterm).
                if (event.kind == PointerEventKind.down) {
                    root.mouse-report(0, root.button-code(event.button), self.mouse-y, self.mouse-x);
                } else if (event.kind == PointerEventKind.move) {
                    root.mouse-report(2, 3, self.mouse-y, self.mouse-x);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.mouse-report(1, root.button-code(event.button), self.mouse-y, self.mouse-x);
                }
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.selection-start(self.mouse-y, self.mouse-x);
            } else if (event.kind == PointerEventKind.move && self.pressed) {
                root.selection-update(self.mouse-y, self.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.selection-end();
            }
        }

        scroll-event(event) => {
            if (event.delta-y != 0) {
                if (root.mouse-tracking) {
                    root.mouse-report(event.delta-y > 0 ? 4 : 3, 0, self.mouse-y, self.mouse-x);
                } else {
                    root.scrolled(event.delta-y);
                }
                return accept;
            }
            reject
        }
    }

    // Barra de scrollback: sólo aparece cuando hay historial.
    if root.scroll-total > 0: Rectangle {
        x: parent.width - 8px;
        y: 0;
        width: 6px;
        height: parent.height;
        background: transparent;

        Rectangle {
            width: parent.width;
            height: max(24px, parent.height * root.scroll-thumb);
            y: (parent.height - self.height) * root.scroll-pos;
            border-radius: 3px;
            background: IdeTheme.text-dim;
        }
    }
}

// Terminal local: encabezado con sesiones + pantalla de una shell real.
//
// Hereda de `FocusScope` para poder recibir el teclado (la ventana apunta acá
// con `forward-focus`). Como `FocusScope` es un elemento de bajo nivel sin
// superficie propia, la parte visual vive en el `Rectangle` interno.
export component IdeTerminal inherits FocusScope {
    in property <[string]> sessions: [];
    in property <int> active-session: 0;
    in property <[TermLine]> lines: [];
    in property <int> scroll-total: 0;
    in property <float> scroll-pos: 1.0;
    in property <float> scroll-thumb: 1.0;
    in property <length> cell-width: 7.2px;
    // Vista dividida: el panel 1 (activo) y el panel 2.
    in property <bool> split-view: false;
    in property <[TermLine]> lines-2: [];
    // Mouse reporting habilitado por el proceso (una bandera por vista).
    in property <bool> mouse-tracking: false;
    in property <bool> mouse-tracking-2: false;
    callback session-selected(int);
    callback new-session();
    callback close();
    callback split();
    // Evento de mouse reenviado al proceso (kind, button, y, x).
    callback mouse-report(int, int, length, length);
    // Tecla cruda: (texto, control, shift, alt). Rust la traduce a bytes.
    callback key-input(string, bool, bool, bool);
    // Tamaño del área de pantalla en píxeles, para dimensionar el PTY.
    callback resized(length, length);
    // Selección de texto con el mouse (y,x en píxeles del área de pantalla).
    callback selection-start(length, length);
    callback selection-update(length, length);
    callback selection-end();
    // Rueda del mouse (delta vertical en píxeles).
    callback scrolled(length);
    // Pegar el portapapeles en la sesión enfocada (botón del medio).
    callback paste-requested();
    // Foco en un panel de la vista dividida (0 = izquierda, 1 = derecha).
    callback focus-pane(int);

    focus-on-click: true;

    key-pressed(event) => {
        root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
        accept
    }

    private property <length> header-h: 30px;

    function report-size() {
        root.resized(self.width, max(0px, self.height - root.header-h));
    }

    changed width => { root.report-size(); }
    changed height => { root.report-size(); }

    // --- superficie visual ---
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: IdeTheme.panel;
        // Opacidad de la superficie del panel (Preferencias → Opacidad).
        opacity: IdeTheme.panel-alpha;
        border-width: IdeTheme.hairline;
        border-color: IdeTheme.border-faint;
        border-radius: IdeTheme.radius;
        clip: true;

        // --- encabezado ---
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.header-h;
            background: IdeTheme.bg;

            // Asa para arrastrar el panel a otro dock (ver ui/ide_dock.slint).
            DockHandle {
                x: 0;
                y: 0;
                height: parent.height;
                panel: 2;
            }

            HorizontalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding-left: 14px;
                padding-right: 8px;
                spacing: 4px;
                alignment: start;
                cross-axis-alignment: center;

                Text {
                    text: "TERMINAL";
                    color: IdeTheme.text-dim;
                    font-family: IdeTheme.sans;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1.6px;
                    vertical-alignment: center;
                }

                Rectangle { width: 8px; background: transparent; }

                for sess[i] in root.sessions: IdeTermSession {
                    label: sess;
                    active: i == root.active-session;
                    activated => { root.session-selected(i); }
                }

                IdeHeaderButton { glyph: "+"; tip: "Nueva sesión de shell (F5 corre en la raíz del proyecto)"; activated => { root.new-session(); } }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                IdeHeaderButton { glyph: "⬒"; split: true; tip: "Dividir la terminal en dos vistas"; activated => { root.split(); } }
                IdeHeaderButton { glyph: "×"; danger: true; tip: "Cerrar esta sesion de terminal"; activated => { root.close(); } }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- pantalla (una o dos vistas) ---
        if !root.split-view: TerminalScreen {
            x: 0;
            y: root.header-h;
            width: parent.width;
            height: parent.height - root.header-h;
            lines: root.lines;
            scroll-total: root.scroll-total;
            scroll-pos: root.scroll-pos;
            scroll-thumb: root.scroll-thumb;
            cell-width: root.cell-width;
            mouse-tracking: root.mouse-tracking;
            selection-start(y, x) => { root.focus(); root.selection-start(y, x); }
            selection-update(y, x) => { root.selection-update(y, x); }
            selection-end => { root.selection-end(); }
            scrolled(dy) => { root.scrolled(dy); }
            mouse-report(k, b, y, x) => { root.mouse-report(k, b, y, x); }
            paste-requested => { root.focus(); root.paste-requested(); }
        }

        if root.split-view: HorizontalLayout {
            x: 0;
            y: root.header-h;
            width: parent.width;
            height: parent.height - root.header-h;
            spacing: 0;

            TerminalScreen {
                width: (parent.width - 6px) / 2;
                height: parent.height;
                lines: root.lines;
                cell-width: root.cell-width;
                mouse-tracking: root.mouse-tracking;
                selection-start(y, x) => { root.focus(); root.focus-pane(0); root.selection-start(y, x); }
                selection-update(y, x) => { root.selection-update(y, x); }
                selection-end => { root.selection-end(); }
                scrolled(dy) => { root.scrolled(dy); }
                mouse-report(k, b, y, x) => { root.focus(); root.focus-pane(0); root.mouse-report(k, b, y, x); }
                paste-requested => { root.focus(); root.focus-pane(0); root.paste-requested(); }
            }

            Rectangle {
                width: 6px;
                height: parent.height;
                background: IdeTheme.border-faint;
            }

            TerminalScreen {
                width: (parent.width - 6px) / 2;
                height: parent.height;
                lines: root.lines-2;
                cell-width: root.cell-width;
                mouse-tracking: root.mouse-tracking-2;
                selection-start(y, x) => { root.focus(); root.focus-pane(1); root.selection-start(y, x); }
                selection-update(y, x) => { root.selection-update(y, x); }
                selection-end => { root.selection-end(); }
                scrolled(dy) => { root.focus-pane(1); root.scrolled(dy); }
                mouse-report(k, b, y, x) => { root.focus(); root.focus-pane(1); root.mouse-report(k, b, y, x); }
                paste-requested => { root.focus(); root.focus-pane(1); root.paste-requested(); }
            }
        }
    }
}
