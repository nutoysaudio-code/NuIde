import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";

// Fila del menú "Ver": panel + dónde está acoplado. Al hacer clic cicla el dock
// (izquierda → derecha → abajo → oculto).
component IdeViewItem inherits Rectangle {
    in property <string> label: "";
    in property <string> detail: "";
    in property <bool> hidden: false;
    in property <int> kind: 0;
    callback activated(int);

    height: 26px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? IdeTheme.control-hi : transparent;

    Tooltip {
        TipContent { text: @tr("Clic para mover {} (actualmente: {})", root.label, root.detail); }
    }

    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: ta.has-hover ? IdeTheme.text : (root.hidden ? IdeTheme.text-dim : IdeTheme.text-soft);
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    detail-text := Text {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        text: root.detail;
        color: root.hidden ? IdeTheme.text-dim : IdeTheme.mint;
        font-family: IdeTheme.sans;
        font-size: 11px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(root.kind); }
    }
}

// Menú desplegable del ítem "Ver": controla dónde vive cada panel. `kind`:
// 0 explorador, 1 OpenCode, 2 terminal, 3 control de código. El dock: 0
// izquierda, 1 derecha, 2 abajo, 3 oculto.
export component IdeViewMenu inherits Rectangle {
    in property <int> dock-explorer: 0;
    in property <int> dock-agent: 1;
    in property <int> dock-terminal: 2;
    in property <int> dock-git: 0;
    callback cycle-dock(int);

    function dock-label(value: int) -> string {
        return value == 0 ? @tr("izquierda")
            : value == 1 ? @tr("derecha")
            : value == 2 ? @tr("abajo")
            : @tr("oculto");
    }

    width: 220px;
    height: menu.preferred-height + 12px;
    background: IdeTheme.panel;
    border-width: 1px;
    border-color: IdeTheme.border-soft;
    border-radius: IdeTheme.radius-sm;

    menu := VerticalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: self.preferred-height;
        spacing: 0;
        alignment: start;

        IdeViewItem {
            label: @tr("Explorador");
            detail: root.dock-label(root.dock-explorer);
            hidden: root.dock-explorer == 3;
            kind: 0;
            activated(k) => { root.cycle-dock(k); }
        }
        IdeViewItem {
            label: @tr("OpenCode CLI");
            detail: root.dock-label(root.dock-agent);
            hidden: root.dock-agent == 3;
            kind: 1;
            activated(k) => { root.cycle-dock(k); }
        }
        IdeViewItem {
            label: @tr("Terminal");
            detail: root.dock-label(root.dock-terminal);
            hidden: root.dock-terminal == 3;
            kind: 2;
            activated(k) => { root.cycle-dock(k); }
        }
        IdeViewItem {
            label: @tr("Control de código");
            detail: root.dock-label(root.dock-git);
            hidden: root.dock-git == 3;
            kind: 3;
            activated(k) => { root.cycle-dock(k); }
        }
    }
}
