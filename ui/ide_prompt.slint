import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";

// Botón del diálogo de entrada.
component PromptButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <string> tip: "";
    callback activated();

    height: 28px;
    width: label-text.width + 24px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? (root.primary ? #9fe6d8 : IdeTheme.control-hi)
        : (root.primary ? IdeTheme.mint : IdeTheme.control);
    border-width: 1px;
    border-color: root.primary ? transparent : IdeTheme.border-soft;

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    label-text := Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? IdeTheme.bg : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Diálogo modal de entrada de texto (nuevo archivo/carpeta, renombrar).
// El texto y el cursor los maneja Rust; acá sólo se dibujan.
export component IdePrompt inherits Rectangle {
    in property <string> title: "";
    in property <string> text: "";
    in property <string> placeholder: "";
    callback accept();
    callback cancel();

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;

        backdrop := TouchArea {
            clicked => { root.cancel(); }
        }
    }

    box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 150px;
        background: IdeTheme.panel;
        border-width: 1px;
        border-color: IdeTheme.border-soft;
        border-radius: IdeTheme.radius;

        Text {
            x: 20px;
            y: 16px;
            text: root.title;
            color: IdeTheme.text;
            font-family: IdeTheme.sans;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            x: 20px;
            y: 46px;
            width: parent.width - 40px;
            height: 30px;
            border-radius: IdeTheme.radius-sm;
            background: IdeTheme.bg;
            border-width: 1px;
            border-color: IdeTheme.mint;

            value-text := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: root.text == "" ? root.placeholder : root.text;
                color: root.text == "" ? IdeTheme.text-dim : IdeTheme.text;
                font-family: IdeTheme.mono;
                font-size: 13px;
                vertical-alignment: center;
            }

            if root.text != "": Rectangle {
                x: value-text.x + value-text.width + 1px;
                y: (parent.height - 16px) / 2;
                width: 1px;
                height: 16px;
                background: IdeTheme.mint;
            }
        }

        Rectangle {
            y: parent.height - 44px;
            width: parent.width;
            height: IdeTheme.hairline;
            background: IdeTheme.border-faint;
        }

        HorizontalLayout {
            x: 20px;
            y: parent.height - 36px;
            width: parent.width - 40px;
            height: 28px;
            spacing: 8px;
            alignment: end;
            cross-axis-alignment: center;

            PromptButton {
                label: "Cancelar";
                tip: @tr("No hacer nada y cerrar (Esc)");
                activated => { root.cancel(); }
            }
            PromptButton {
                label: "Aceptar";
                primary: true;
                tip: @tr("Confirmar y cerrar (Enter)");
                activated => { root.accept(); }
            }
        }
    }
}
