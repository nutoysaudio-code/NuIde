import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";

// Icono de rama Git dibujado con rectángulos (no depende de glifos raros).
component IdeBranchIcon inherits Rectangle {
    width: 13px;
    height: 13px;
    background: transparent;

    Rectangle { x: 3px; y: 2px; width: 2px; height: 9px; background: IdeTheme.text-soft; }
    Rectangle { x: 7px; y: 4px; width: 4px; height: 2px; background: IdeTheme.text-soft; }
    Rectangle { x: 2px; y: 0px; width: 4px; height: 4px; border-radius: 2px; background: IdeTheme.mint; }
    Rectangle { x: 7px; y: 3px; width: 4px; height: 4px; border-radius: 2px; background: IdeTheme.text-soft; }
    Rectangle { x: 7px; y: 8px; width: 4px; height: 4px; border-radius: 2px; background: IdeTheme.text-soft; }
}

// Separador vertical fino entre metadatos del pie.
component IdeStatusDivider inherits Rectangle {
    width: 1px;
    height: 12px;
    background: IdeTheme.border-soft;
}

// Barra inferior: rama Git, lenguaje, codificación y posición del cursor.
export component IdeStatusBar inherits Rectangle {
    in property <string> branch: "main";
    in property <string> language: "SpASM";
    in property <string> encoding: "UTF-8";
    in property <int> line: 24;
    in property <int> column: 8;
    // Resultado del último análisis de SpASM (vacío si no hay errores).
    in property <string> diagnostics: "";
    // Uso del sistema (porcentajes enteros), discreto a la derecha.
    in property <int> cpu: 0;
    in property <int> ram: 0;
    // La app corre con privilegios de administrador (Windows).
    in property <bool> elevated: false;

    height: IdeTheme.statusbar-h;
    background: IdeTheme.panel;

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Text {
            visible: root.elevated;
            text: @tr("ADMIN");
            color: IdeTheme.amber;
            font-family: IdeTheme.mono;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("NuIde corre con privilegios de administrador: las terminales del panel son elevadas"); }
            }
        }
        IdeBranchIcon { }
        Text {
            text: root.branch;
            color: IdeTheme.text-soft;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("Rama actual de Git - clic en el panel de código para cambiarla"); }
            }
        }

        Text {
            text: root.diagnostics;
            color: IdeTheme.del;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("Errores y avisos del análisis del archivo abierto (F6); F8 salta al siguiente"); }
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Text {
            text: root.language;
            color: IdeTheme.mint;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("Lenguaje detectado por la extensión del archivo activo"); }
            }
        }
        IdeStatusDivider { }
        Text {
            text: root.encoding;
            color: IdeTheme.text-soft;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("Codificación con la que se lee y se guarda el archivo"); }
            }
        }
        IdeStatusDivider { }
        Text {
            text: @tr("Ln {}, Col {}", root.line, root.column);
            color: IdeTheme.text-soft;
            font-family: IdeTheme.sans;
            font-size: 11px;
            vertical-alignment: center;

            Tooltip {
                TipContent { text: @tr("Posición del cursor (línea, columna) en el editor"); }
            }
        }

        IdeStatusDivider { }
        Text {
            text: @tr("CPU {}%", root.cpu);
            color: IdeTheme.text-dim;
            font-family: IdeTheme.mono;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: @tr("RAM {}%", root.ram);
            color: IdeTheme.text-dim;
            font-family: IdeTheme.mono;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    // Línea superior de 1 px.
    Rectangle {
        y: 0;
        width: parent.width;
        height: IdeTheme.hairline;
        background: IdeTheme.border-soft;
    }
}
