// Tema visual de NuIde: instrumento electrónico retrofuturista sobrio.
//
// Paleta oscura dada por la especificación (docs/NUIDE_IDEA.md),
// pensada para que el código siga siendo el protagonista. La tipografía sans es
// local y la mono usa la pila monoespaciada del sistema: NuIde no depende de
// ningún kit compartido.

export global IdeTheme {
    // --- superficies ---
    in-out property <color> bg: #101718;
    in-out property <color> panel: #151d1f;
    in-out property <color> panel-hi: #1a2325;
    in-out property <color> control: #202a2c;
    in-out property <color> control-hi: #263234;

    // --- bordes ---
    in-out property <color> border: #69716c;
    in-out property <color> border-soft: #333d3b;
    in-out property <color> border-faint: #232c2a;

    // --- texto ---
    in-out property <color> text: #e8e2d0;      // marfil
    in-out property <color> text-soft: #94a09e;  // secundario
    in-out property <color> text-dim: #5f6a67;   // terciario / comentarios

    // --- acentos ---
    in-out property <color> mint: #83d9cb;
    in-out property <color> amber: #e7ba70;
    in-out property <color> selection: #294443;
    in-out property <color> add: #8fc9a1;
    in-out property <color> del: #d98c8c;
    in-out property <color> online: #78d69a;

    // --- resaltados del editor ---
    in-out property <color> word-match: #223331;    // palabra bajo el cursor
    in-out property <color> bracket-match: #3a4a44; // par de llaves
    in-out property <color> find-match: #3d3a24;    // coincidencia de búsqueda
    in-out property <color> find-current: #6b5a24;  // coincidencia actual

    // --- semántica del editor ---
    in-out property <color> code-text: #e8e2d0;
    in-out property <color> code-comment: #6c7a76;
    in-out property <color> code-keyword: #83d9cb;
    in-out property <color> code-string: #e7ba70;
    in-out property <color> code-number: #d6a5e0;
    in-out property <color> code-soft: #94a09e;
    in-out property <color> active-line: #ffffff0c;

    // --- métricas ---
    in-out property <length> radius: 7px;
    in-out property <length> radius-sm: 5px;
    in-out property <length> topbar-h: 42px;
    in-out property <length> statusbar-h: 28px;
    in-out property <length> splitter: 6px;
    in-out property <length> hairline: 1px;
    // Tamaño de la fuente del código (configurable desde Preferencias).
    in-out property <length> editor-font-size: 12px;

    // --- tipografía ---
    // Slint NO soporta listas separadas por comas: `font-family` es un único
    // nombre de familia. Rust elige la mejor instalada al arrancar (ver
    // `editor::attach`); estos son los valores de respaldo.
    in-out property <string> sans: "Segoe UI";
    in-out property <string> mono: "Consolas";
}
