import { IdeTheme } from "ide_theme.slint";
import { IdeTab, IdeCodeLine, IdeOutlineItem, IdeRecent } from "ide_types.slint";
import { IdeWelcome } from "ide_welcome.slint";
import { TipContent } from "ide_tooltip.slint";

// Pestaña del editor con punto de "sin guardar" y botón de cierre.
component IdeTabButton inherits Rectangle {
    in property <string> title: "main.spasm";
    in property <bool> active: false;
    in property <bool> dirty: false;
    callback activated();
    callback closed();

    height: 34px;
    width: tab-text.width + 52px;
    background: root.active ? IdeTheme.control : (ta.has-hover ? IdeTheme.control-hi : transparent);

    Tooltip {
        TipContent { text: root.title + (root.dirty ? @tr(" (sin guardar)") : "") + (root.active ? @tr(" [activa]") : ""); }
    }

    // Subrayado menta de la pestaña activa.
    Rectangle {
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? IdeTheme.mint : transparent;
    }

    tab-text := Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.title;
        color: root.active ? IdeTheme.text : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    // Punto ámbar si hay cambios sin guardar.
    Rectangle {
        x: tab-text.x + tab-text.width + 9px;
        y: (parent.height - 6px) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: IdeTheme.amber;
        visible: root.dirty;
    }

    // Cierre.
    Text {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        text: "×";
        color: close-ta.has-hover ? IdeTheme.del : IdeTheme.text-dim;
        font-family: IdeTheme.sans;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }

    close-ta := TouchArea {
        x: parent.width - 24px;
        y: 0;
        width: 24px;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.closed(); }
    }
}

// Fila de código: número de línea + tokens monoespaciados.
component IdeCodeRow inherits Rectangle {
    in property <int> num: 1;
    in property <IdeCodeLine> line;
    in property <bool> active: false;

    height: IdeTheme.editor-font-size + 8px;
    background: root.active ? IdeTheme.active-line : transparent;

    // Barra de la línea activa o con error (el error gana).
    Rectangle {
        y: 0;
        width: 2px;
        height: parent.height;
        background: root.line.error ? IdeTheme.del
            : root.active ? IdeTheme.mint
            : transparent;
    }

    Text {
        x: 0;
        y: 0;
        width: 46px;
        height: parent.height;
        text: root.num;
        color: root.line.error ? IdeTheme.del
            : root.active ? IdeTheme.text-soft
            : IdeTheme.text-dim;
        font-family: IdeTheme.mono;
        font-size: IdeTheme.editor-font-size;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 58px + root.line.indent;
        y: 0;
        height: parent.height;
        spacing: 0;
        alignment: start;
        cross-axis-alignment: center;

        for tok in root.line.tokens: Rectangle {
            // Cada token se envuelve para poder pintar el fondo de selección
            // (kind 7) o de los resaltados: palabra (11), llave (10), búsqueda
            // (8) y coincidencia actual (9).
            width: tok-text.width;
            height: parent.height;
            background: tok.kind == 7 ? IdeTheme.selection
                : tok.kind == 8 ? IdeTheme.find-match
                : tok.kind == 9 ? IdeTheme.find-current
                : tok.kind == 10 ? IdeTheme.bracket-match
                : tok.kind == 11 ? IdeTheme.word-match
                : transparent;

            tok-text := Text {
                text: tok.text;
                color: tok.kind == 1 ? IdeTheme.code-comment
                    : tok.kind == 2 ? IdeTheme.code-keyword
                    : tok.kind == 3 ? IdeTheme.code-string
                    : tok.kind == 4 ? IdeTheme.code-number
                    : tok.kind == 5 ? IdeTheme.mint
                    : tok.kind == 6 ? IdeTheme.mint
                    : IdeTheme.code-text;
                font-family: IdeTheme.mono;
                font-size: IdeTheme.editor-font-size;
                height: parent.height;
                vertical-alignment: center;
            }
        }
    }
}

// Botón compacto de la barra de búsqueda.
component IdeFindButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <string> tip: "";
    callback activated();

    width: fb-text.width + 14px;
    height: 20px;
    border-radius: IdeTheme.radius-sm;
    background: fb-ta.has-hover ? (root.danger ? #d98c8c33 : IdeTheme.control-hi)
        : (root.active ? IdeTheme.control-hi : transparent);

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    fb-text := Text {
        x: 7px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: fb-ta.has-hover ? (root.danger ? IdeTheme.del : IdeTheme.text)
            : (root.active ? IdeTheme.mint : IdeTheme.text-soft);
        font-family: IdeTheme.sans;
        font-size: 11px;
        vertical-alignment: center;
    }

    fb-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Editor central: pestañas, ruta de navegación y área de código con scroll.
//
// Hereda de `FocusScope` para recibir el teclado cuando se lo clickea. Como
// `FocusScope` no tiene superficie propia, lo visual vive en el `Rectangle`
// interno.
export component IdeEditor inherits FocusScope {
    in property <[IdeTab]> tabs: [];
    in property <int> active-tab: 0;
    in property <[string]> breadcrumb: [];
    in property <[IdeCodeLine]> lines: [];
    in property <int> active-line: 1;
    // Búsqueda.
    in property <bool> find-open: false;
    in property <bool> find-replace-open: false;
    in property <string> find-query: "";
    in property <string> find-replace: "";
    in property <string> find-info: "";
    in property <bool> find-focus-replace: false;
    in property <bool> find-case: false;
    in property <bool> find-whole-word: false;
    in property <bool> find-regex: false;
    in property <bool> find-in-selection: false;
    // Texto antes y después del cursor de cada campo (para dibujar el caret en
    // su posición sin operaciones de string en Slint).
    in property <string> find-query-before: "";
    in property <string> find-query-after: "";
    in property <string> find-replace-before: "";
    in property <string> find-replace-after: "";
    // Visores.
    in property <bool> show-image: false;
    in property <image> active-image;
    in property <float> image-zoom: 1.0;
    in property <bool> show-preview: false;
    in property <styled-text> preview-styled;
    in property <bool> is-markdown: false;
    // Esquema de símbolos del archivo.
    in property <[IdeOutlineItem]> outline: [];
    in-out property <bool> outline-open: false;
    // Pantalla de bienvenida (sin archivos abiertos).
    in property <bool> welcome: false;
    // Recientes de la bienvenida (proyectos y archivos).
    in property <[IdeRecent]> welcome-recent: [];
    callback tab-selected(int);
    callback tab-closed(int);
    // Tecla cruda: (texto, ¿control?, ¿shift?), igual que en la terminal.
    callback key-input(string, bool, bool);
    // Mouse: (y, x, scroll-y) en coordenadas de la vista. Rust calcula línea y
    // columna. Un clic coloca el cursor; un arrastre extiende la selección.
    callback cursor-to(length, length, length);
    callback extend-to(length, length, length);
    // Acciones de la barra de búsqueda.
    callback find-next();
    callback find-prev();
    callback find-close();
    callback find-toggle-replace();
    callback find-toggle-case();
    callback find-toggle-word();
    callback find-toggle-regex();
    callback find-toggle-selection();
    callback find-focus(bool);
    callback replace-one();
    callback replace-all();
    // Alterna la vista previa de Markdown.
    callback preview-toggle();
    // Zoom del visor de imagen.
    callback image-zoom-in();
    callback image-zoom-out();
    callback image-zoom-reset();
    // Salta a la línea de un símbolo del esquema.
    callback goto-line(int);
    // Acciones de la bienvenida.
    callback open-project();
    callback open-file();
    callback new-file();
    callback open-recent(int);

    focus-on-click: true;

    key-pressed(event) => {
        root.key-input(event.text, event.modifiers.control, event.modifiers.shift);
        accept
    }

    // Geometría del área de código (debe coincidir con `IdeCodeRow`).
    private property <length> row-h: IdeTheme.editor-font-size + 8px;
    // Alto de la barra de búsqueda cuando está abierta.
    private property <length> find-h: root.find-open ? (root.find-replace-open ? 64px : 34px) : 0px;
    private property <length> canvas-y: 60px + root.find-h;
    private property <length> cursor-y: 8px + (root.active-line - 1) * root.row-h;
    in-out property <bool> selecting: false;

    // Auto-scroll: deja visible la línea activa cuando el cursor se mueve.
    function ensure-cursor-visible() {
        if (root.cursor-y < -code-scroll.content-y) {
            code-scroll.content-y = max(code-scroll.height - code-scroll.content-height, min(0px, -root.cursor-y));
        } else if (root.cursor-y + root.row-h > -code-scroll.content-y + code-scroll.height) {
            code-scroll.content-y = max(code-scroll.height - code-scroll.content-height, min(0px, -(root.cursor-y + root.row-h - code-scroll.height)));
        }
    }

    changed active-line => { root.ensure-cursor-visible(); }

    // --- superficie visual ---
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: IdeTheme.panel;
        border-width: IdeTheme.hairline;
        border-color: transparent;
        border-radius: IdeTheme.radius;
        clip: true;

        // --- barra de pestañas ---
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 34px;
            background: IdeTheme.bg;

            HorizontalLayout {
                x: 0;
                y: 0;
                height: parent.height;
                padding-left: 6px;
                spacing: 2px;
                alignment: start;
                cross-axis-alignment: stretch;

                for tab[i] in root.tabs: IdeTabButton {
                    title: tab.title;
                    dirty: tab.dirty;
                    active: i == root.active-tab;
                    activated => { root.focus(); root.tab-selected(i); }
                    closed => { root.tab-closed(i); }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                if root.outline.length > 0: Rectangle {
                    width: outline-text.width + 16px;
                    border-radius: IdeTheme.radius-sm;
                    background: outline-ta.has-hover ? IdeTheme.control-hi : transparent;

                    outline-text := Text {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        text: "Esquema";
                        color: root.outline-open ? IdeTheme.mint : IdeTheme.text-soft;
                        font-family: IdeTheme.sans;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    outline-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.outline-open = !root.outline-open; }
                    }
                }

                if root.is-markdown: Rectangle {
                    width: md-text.width + 16px;
                    border-radius: IdeTheme.radius-sm;
                    background: md-ta.has-hover ? IdeTheme.control-hi : transparent;

                    md-text := Text {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        text: root.show-preview ? "Código" : "Vista";
                        color: IdeTheme.mint;
                        font-family: IdeTheme.sans;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    md-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.preview-toggle(); }
                    }
                }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- ruta de navegación ---
        Rectangle {
            x: 0;
            y: 34px;
            width: parent.width;
            height: 26px;
            background: IdeTheme.panel;

            HorizontalLayout {
                x: 0;
                y: 0;
                height: parent.height;
                padding-left: 16px;
                spacing: 0;
                alignment: start;
                cross-axis-alignment: center;

                for seg[i] in root.breadcrumb: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Text {
                        text: seg;
                        color: i == root.breadcrumb.length - 1 ? IdeTheme.text : IdeTheme.text-soft;
                        font-family: IdeTheme.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "›";
                        color: IdeTheme.text-dim;
                        font-family: IdeTheme.sans;
                        font-size: 11px;
                        vertical-alignment: center;
                        visible: i < root.breadcrumb.length - 1;
                    }
                }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- barra de búsqueda ---
        if root.find-open: Rectangle {
            x: 0;
            y: 60px;
            width: parent.width;
            height: root.find-h;
            background: IdeTheme.control;

            VerticalLayout {
                x: 10px;
                y: 6px;
                width: parent.width - 20px;
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    height: 22px;
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Text {
                        text: "Buscar";
                        color: IdeTheme.text-dim;
                        font-family: IdeTheme.sans;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 240px;
                        height: 22px;
                        border-radius: IdeTheme.radius-sm;
                        background: IdeTheme.bg;
                        border-width: 1px;
                        border-color: !root.find-focus-replace ? IdeTheme.mint : IdeTheme.border-soft;
                        clip: true;

                        HorizontalLayout {
                            x: 6px;
                            y: 0;
                            height: parent.height;
                            spacing: 0;
                            alignment: start;
                            cross-axis-alignment: center;

                            Text {
                                text: root.find-query-before;
                                color: IdeTheme.text;
                                font-family: IdeTheme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                visible: !root.find-focus-replace;
                                width: 1px;
                                height: 13px;
                                background: IdeTheme.mint;
                            }
                            Text {
                                text: root.find-query-after;
                                color: IdeTheme.text;
                                font-family: IdeTheme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.text;
                            clicked => { root.find-focus(false); }
                        }
                    }

                    Text {
                        text: root.find-info;
                        color: IdeTheme.text-soft;
                        font-family: IdeTheme.mono;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    IdeFindButton { label: "‹"; tip: @tr("Anterior coincidencia (Shift+F3)"); activated => { root.find-prev(); } }
                    IdeFindButton { label: "›"; tip: @tr("Siguiente coincidencia (F3)"); activated => { root.find-next(); } }
                    IdeFindButton { label: "Aa"; active: root.find-case; tip: @tr("Coincidir mayúsculas/minúsculas"); activated => { root.find-toggle-case(); } }
                    IdeFindButton { label: "Palabra"; active: root.find-whole-word; tip: @tr("Coincidir palabra completa"); activated => { root.find-toggle-word(); } }
                    IdeFindButton { label: ".*"; active: root.find-regex; tip: @tr("Expresión regular"); activated => { root.find-toggle-regex(); } }
                    IdeFindButton { label: "Sel."; active: root.find-in-selection; tip: @tr("Buscar sólo en la selección"); activated => { root.find-toggle-selection(); } }
                    IdeFindButton { label: "⇄"; active: root.find-replace-open; tip: @tr("Mostrar u ocultar el campo de reemplazo"); activated => { root.find-toggle-replace(); } }
                    IdeFindButton { label: "×"; danger: true; tip: @tr("Cerrar la búsqueda (Esc)"); activated => { root.find-close(); } }
                }

                if root.find-replace-open: HorizontalLayout {
                    height: 22px;
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Text {
                        text: "Reemplazar";
                        color: IdeTheme.text-dim;
                        font-family: IdeTheme.sans;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 240px;
                        height: 22px;
                        border-radius: IdeTheme.radius-sm;
                        background: IdeTheme.bg;
                        border-width: 1px;
                        border-color: root.find-focus-replace ? IdeTheme.mint : IdeTheme.border-soft;
                        clip: true;

                        HorizontalLayout {
                            x: 6px;
                            y: 0;
                            height: parent.height;
                            spacing: 0;
                            alignment: start;
                            cross-axis-alignment: center;

                            Text {
                                text: root.find-replace-before;
                                color: IdeTheme.text;
                                font-family: IdeTheme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                visible: root.find-focus-replace;
                                width: 1px;
                                height: 13px;
                                background: IdeTheme.mint;
                            }
                            Text {
                                text: root.find-replace-after;
                                color: IdeTheme.text;
                                font-family: IdeTheme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.text;
                            clicked => { root.find-focus(true); }
                        }
                    }

                    IdeFindButton { label: "Reemplazar"; tip: @tr("Reemplazar esta coincidencia (Enter)"); activated => { root.replace-one(); } }
                    IdeFindButton { label: "Todo"; tip: @tr("Reemplazar todas las coincidencias"); activated => { root.replace-all(); } }
                }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-soft;
            }
        }

        // --- área de código ---
        code-scroll := Flickable {
            x: 0;
            y: root.canvas-y;
            width: parent.width;
            height: parent.height - root.canvas-y;
            visible: !root.show-image && !root.show-preview && !root.welcome;
            content-width: self.width;
            content-height: code.preferred-height + 16px;

            code := VerticalLayout {
                x: 0;
                y: 8px;
                width: parent.width;
                spacing: 0;

                for line[i] in root.lines: IdeCodeRow {
                    num: i + 1;
                    line: line;
                    active: (i + 1) == root.active-line;
                }
            }
        }

        // --- input del mouse (encima del scroll) ---
        //
        // Un solo TouchArea para todo el lienzo: así un arrastre puede cruzar de
        // línea sin depender de los bordes de cada fila. Captura el arrastre
        // para seleccionar; la rueda sigue scrolleando la Flickable de abajo.
        canvas := TouchArea {
            x: 0;
            y: root.canvas-y;
            width: parent.width;
            height: parent.height - root.canvas-y;
            visible: !root.show-image && !root.show-preview && !root.welcome;
            mouse-cursor: MouseCursor.text;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    // El TouchArea captura el clic, así que hay que darle el foco
                    // al editor explícitamente (si no, el teclado sigue yendo a
                    // la terminal).
                    root.focus();
                    root.selecting = true;
                    root.cursor-to(self.mouse-y, self.mouse-x, code-scroll.content-y);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.selecting = false;
                }
            }

            moved => {
                if (root.selecting) {
                    root.extend-to(self.mouse-y, self.mouse-x, code-scroll.content-y);
                }
            }
        }

        // --- bienvenida (sin archivos abiertos) ---
        if root.welcome: IdeWelcome {
            x: 0;
            y: root.canvas-y;
            width: parent.width;
            height: parent.height - root.canvas-y;
            open-project => { root.open-project(); }
            open-file => { root.open-file(); }
            new-file => { root.new-file(); }
            open-recent(i) => { root.open-recent(i); }
            recent: root.welcome-recent;
        }

        // --- visor de imagen (zoom + paneo) ---
        if root.show-image: Rectangle {
            x: 0;
            y: root.canvas-y;
            width: parent.width;
            height: parent.height - root.canvas-y;
            background: IdeTheme.bg;
            clip: true;

            img-scroll := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: img-scroll.width * root.image-zoom;
                content-height: img-scroll.height * root.image-zoom;

                Image {
                    source: root.active-image;
                    x: 0;
                    y: 0;
                    width: img-scroll.content-width;
                    height: img-scroll.content-height;
                    image-fit: contain;
                }
            }

            // Controles de zoom.
            HorizontalLayout {
                x: parent.width - 104px;
                y: 8px;
                height: 22px;
                spacing: 4px;
                alignment: start;

                IdeFindButton { label: "−"; tip: @tr("Alejar la imagen (Ctrl+-)"); activated => { root.image-zoom-out(); } }
                IdeFindButton { label: "+"; tip: @tr("Acercar la imagen (Ctrl++)"); activated => { root.image-zoom-in(); } }
                IdeFindButton { label: "Ajustar"; tip: @tr("Ajustar la imagen al tamaño del panel"); activated => { root.image-zoom-reset(); } }
            }
        }

        // --- vista previa de Markdown ---
        if root.show-preview: Flickable {
            x: 0;
            y: root.canvas-y;
            width: parent.width;
            height: parent.height - root.canvas-y;
            content-width: self.width;
            content-height: preview.preferred-height + 24px;

            preview := StyledText {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                text: root.preview-styled;
                default-color: IdeTheme.text;
                default-font-family: IdeTheme.sans;
                default-font-size: 13px;
                link-color: IdeTheme.mint;
            }
        }

        // --- capa que cierra el esquema al hacer clic afuera ---
        if root.outline-open: TouchArea {
            clicked => { root.outline-open = false; }
        }

        // --- desplegable del esquema (outline) ---
        if root.outline-open: Rectangle {
            x: parent.width - 260px;
            y: 34px;
            width: 250px;
            height: min(parent.height - 40px, root.outline.length * 24px + 12px);
            background: IdeTheme.panel;
            border-width: 1px;
            border-color: IdeTheme.border-soft;
            border-radius: IdeTheme.radius-sm;
            clip: true;

            Flickable {
                x: 0;
                y: 6px;
                width: parent.width;
                height: parent.height - 12px;
                content-width: self.width;
                content-height: outline-menu.preferred-height;

                outline-menu := VerticalLayout {
                    width: parent.width;
                    spacing: 0;

                    for item in root.outline: Rectangle {
                        height: 24px;
                        background: outline-row.has-hover ? IdeTheme.control-hi : transparent;

                        Text {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            text: item.label;
                            color: item.kind == 0 ? IdeTheme.mint : IdeTheme.text;
                            font-family: IdeTheme.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            x: parent.width - self.width - 10px;
                            y: (parent.height - self.height) / 2;
                            text: item.detail;
                            color: IdeTheme.text-dim;
                            font-family: IdeTheme.sans;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        outline-row := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.goto-line(item.line); root.outline-open = false; }
                        }
                    }
                }
            }
        }
    }
}
