import { IdeTheme } from "ide_theme.slint";
export { IdeTheme, DockDrag }
import { IdeTreeNode, IdeTab, IdeCodeLine, TermLine, IdeOutlineItem, IdeRecent, IdeGitFile, IdePaletteItem, IdeMenuEntry, IdeSearchHit, IdeDiffLine, IdePrefRow, IdeSetting, IdeChatMsg, IdeChatModel, IdeFtpEntry, IdeModelRow, IdeSkillRow } from "ide_types.slint";
import { IdeTopBar } from "ide_topbar.slint";
import { IdeStatusBar } from "ide_statusbar.slint";
import { IdeExplorer } from "ide_explorer.slint";
import { IdeEditor } from "ide_editor.slint";
import { IdeTerminal } from "ide_terminal.slint";
import { IdeAgent } from "ide_agent.slint";
import { IdeNucoder } from "ide_nucoder.slint";
import { IdeGit } from "ide_git.slint";
import { DockDrag } from "ide_dock.slint";
import { IdeViewMenu } from "ide_viewmenu.slint";
import { IdePalette } from "ide_palette.slint";
import { IdeMenu } from "ide_menu.slint";
import { IdeConfirm, IdeAsk } from "ide_confirm.slint";
import { IdePrompt } from "ide_prompt.slint";
import { IdeSearch } from "ide_search.slint";
import { IdeDiff } from "ide_diff.slint";
import { IdePrefs } from "ide_prefs.slint";
import { IdeSettings } from "ide_settings.slint";
import { IdeProvider } from "ide_provider.slint";
import { IdeSqlite } from "ide_sqlite.slint";
import { IdeFtp } from "ide_ftp.slint";
import { IdeSkills } from "ide_skills.slint";
import { IdeAbout } from "ide_about.slint";

// ---------------------------------------------------------------------------
// NuIde — IDE multi-lenguaje (walking skeleton)
//
// Monta el layout de la especificación: barra superior, tres columnas
// (explorador / editor + terminal / Agente CLI) con divisores arrastrables, y
// barra inferior de estado. Los datos de archivos, código y terminales son
// ilustrativos (ver docs/NUIDE_IDEA.md): sirven para iterar la UI sin motor.
//
// Los divisores se arrastran con un único `TouchArea` estacionario detrás de
// los paneles: al no moverse, `mouse-x`/`mouse-y` son coordenadas estables del
// área de contenido. Los huecos de 6 px entre paneles son la zona sensible.
// ---------------------------------------------------------------------------

export component NuIdeWindow inherits Window {
    title: "NuIde";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1000px;
    min-height: 640px;
    background: IdeTheme.bg;

    // Reparto de espacio (fracciones) y modo de arrastre activo.
    in-out property <float> left-frac: 0.18;
    in-out property <float> right-frac: 0.28;
    in-out property <float> bottom-frac: 0.25;
    in-out property <int> drag-mode: 0;

    // Paneles visibles y estado del menú "Ver". Los maneja Rust.
    in-out property <bool> show-left: true;
    in-out property <bool> show-right: true;
    in-out property <bool> show-bottom: true;
    // Dock de cada panel: 0 izquierda, 1 derecha, 2 abajo, 3 oculto.
    in-out property <int> dock-explorer: 0;
    in-out property <int> dock-agent: 1;
    in-out property <int> dock-terminal: 2;
    in-out property <int> dock-git: 0;
    // Menú desplegable abierto ("Archivo", "Editar", "Ver") o vacío.
    in-out property <string> menu-open: "";
    in-out property <[IdeMenuEntry]> menu-items: [];
    // Diálogo de "cambios sin guardar".
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-message: "";
    // Explorador: filtro de generados y menú contextual.
    in-out property <bool> explorer-show-generated: true;
    in-out property <bool> explorer-context-open: false;
    in-out property <[IdeMenuEntry]> explorer-context-items: [];
    // Menú contextual de las terminales (clic derecho).
    in-out property <bool> term-context-open: false;
    in-out property <[IdeMenuEntry]> term-context-items: [];
    in-out property <length> term-context-x: 0px;
    in-out property <length> term-context-y: 0px;
    // Diálogo de entrada de texto.
    in-out property <bool> prompt-open: false;
    in-out property <string> prompt-title: "";
    in-out property <string> prompt-text: "";
    in-out property <string> prompt-placeholder: "";
    // Buscar en el proyecto.
    in-out property <bool> search-open: false;
    in-out property <bool> search-replace-open: false;
    in-out property <bool> search-case: false;
    in-out property <bool> search-regex: false;
    in-out property <bool> search-focus-replace: false;
    in-out property <bool> search-searching: false;
    in-out property <string> search-info: "";
    in-out property <string> search-query-before: "";
    in-out property <string> search-query-after: "";
    in-out property <string> search-replace-before: "";
    in-out property <string> search-replace-after: "";
    in-out property <[IdeSearchHit]> search-hits: [];
    in-out property <int> search-selected: -1;
    // Diálogo de dos botones (eliminar).
    in-out property <bool> ask-open: false;
    in-out property <string> ask-title: "";
    in-out property <string> ask-message: "";
    in-out property <string> ask-accept-label: "Aceptar";
    in-out property <bool> ask-danger: false;

    // Selección de la UI (índices, no modelos reconstruidos).
    in-out property <int> explorer-selected: 2;
    in-out property <int> active-tab: 0;
    in-out property <int> active-session: 0;

    // Proyecto y editor reales.
    in-out property <string> project-name: "coquito";
    in-out property <int> active-line: 1;
    in-out property <int> active-column: 1;
    // Lenguaje del archivo activo (barra de estado).
    in-out property <string> language: "SpASM";
    // Visores: imagen y vista previa de Markdown.
    in-out property <bool> show-image: false;
    in-out property <image> active-image;
    in-out property <float> image-zoom: 1.0;
    in-out property <bool> show-preview: false;
    in-out property <styled-text> preview-styled;
    in-out property <bool> is-markdown: false;
    // Esquema de símbolos del archivo activo.
    in-out property <[IdeOutlineItem]> outline: [];
    // Completado semántico (Ctrl+Espacio).
    in-out property <bool> editor-complete-open: false;
    in-out property <[IdePaletteItem]> editor-complete-items: [];
    in-out property <int> editor-complete-selected: 0;
    // Pantalla de bienvenida del editor.
    in-out property <bool> welcome: false;
    // Recientes de la bienvenida (proyectos y archivos).
    in-out property <[IdeRecent]> welcome-recent: [];
    // Git (control de código).
    in-out property <bool> git-repo: false;
    in-out property <string> git-branch: "main";
    in-out property <string> git-note: "";
    in-out property <bool> git-error: false;
    in-out property <bool> git-busy: false;
    in-out property <string> git-message: "";
    in-out property <[IdeGitFile]> git-staged: [];
    in-out property <[IdeGitFile]> git-changes: [];
    // Git: "↑2 ↓1".
    in-out property <string> git-sync-info: "";
    // Menú de ramas.
    in-out property <bool> branch-menu-open: false;
    in-out property <[IdeMenuEntry]> branch-menu-items: [];
    // Visor de diff.
    in-out property <bool> diff-open: false;
    in-out property <string> diff-title: "";
    in-out property <string> diff-note: "";
    in-out property <bool> diff-error: false;
    in-out property <bool> diff-staged: false;
    in-out property <bool> diff-busy: false;
    in-out property <[IdeDiffLine]> diff-lines: [];
    // Preferencias.
    in-out property <bool> prefs-open: false;
    in-out property <string> prefs-mono: "";
    in-out property <string> prefs-sans: "";
    in-out property <string> prefs-alpha: "";
    in-out property <string> prefs-editor-size: "12";
    in-out property <string> prefs-accent: "";
    in-out property <color> prefs-accent-color: #83d9cb;
    in-out property <string> prefs-tab-size: "4";
    in-out property <bool> prefs-insert-spaces: true;
    in-out property <bool> prefs-build-on-save: false;
    in-out property <string> prefs-capturing: "";
    in-out property <[IdePrefRow]> prefs-keys: [];
    // Acerca de.
    in-out property <bool> about-open: false;
    in-out property <string> about-version: "0.1.0";
    // Paleta de comandos / buscador de archivos.
    in-out property <bool> palette-open: false;
    in-out property <string> palette-title: "";
    in-out property <string> palette-query: "";
    in-out property <[IdePaletteItem]> palette-items: [];
    in-out property <int> palette-selected: -1;
    // Diagnóstico de SpASM (vacío si no hay errores).
    in-out property <string> diagnostics: "";
    // Uso del sistema (porcentajes enteros).
    in-out property <int> cpu-percent: 0;
    in-out property <int> ram-percent: 0;
    // La app corre con privilegios de administrador (Windows).
    in-out property <bool> elevated: false;

    // Búsqueda del editor.
    in-out property <bool> find-open: false;
    in-out property <bool> find-replace-open: false;
    in-out property <string> find-query: "";
    in-out property <string> find-replace: "";
    in-out property <string> find-info: "";
    in-out property <bool> find-focus-replace: false;
    in-out property <bool> find-case: false;
    in-out property <bool> find-whole-word: false;
    in-out property <bool> find-regex: false;
    in-out property <bool> find-in-selection: false;
    in-out property <string> find-query-before: "";
    in-out property <string> find-query-after: "";
    in-out property <string> find-replace-before: "";
    in-out property <string> find-replace-after: "";

    // Panel del agente: estado y scrollback.
    in-out property <bool> agent-connected: false;
    in-out property <string> agent-version: "Agente";
    in-out property <string> agent-model: "por defecto";
    in-out property <int> agent-scroll-total: 0;
    in-out property <float> agent-scroll-pos: 1.0;
    in-out property <float> agent-scroll-thumb: 1.0;

    // Terminal real: estado del scrollback (lo llena Rust).
    in-out property <int> term-scroll-total: 0;
    in-out property <float> term-scroll-pos: 1.0;
    in-out property <float> term-scroll-thumb: 1.0;
    // Vista dividida de la terminal.
    in-out property <bool> term-split: false;
    in-out property <[TermLine]> term-lines-2: [];
    // Mouse reporting (lo habilita el proceso de cada terminal).
    in-out property <bool> term-mouse: false;
    in-out property <bool> term-mouse-2: false;
    in-out property <bool> agent-mouse-tracking: false;

    // Panel nativo de NuCoder (chat del agente en Slint).
    in-out property <bool> nucoder-open: false;
    in-out property <[IdeChatMsg]> nucoder-messages: [];
    in-out property <string> nucoder-model: "auto (router)";
    in-out property <string> nucoder-task: "complete";
    in-out property <bool> nucoder-free: false;
    in-out property <bool> nucoder-running: false;
    in-out property <bool> nucoder-auto-approve: false;
    in-out property <bool> nucoder-connected: true;
    in-out property <int> nucoder-images: 0;
    in-out property <bool> nucoder-pending: false;
    in-out property <string> nucoder-pending-title: "";
    in-out property <string> nucoder-pending-detail: "";
    in-out property <string> nucoder-draft: "";
    in-out property <[IdeChatModel]> nucoder-models: [];
    in-out property <int> nucoder-model-index: -1;
    in-out property <[IdeModelRow]> nucoder-model-rows: [];
    in-out property <string> nucoder-model-filter: "";
    in-out property <string> nucoder-model-sort: "especialidad";
    in-out property <[string]> nucoder-tasks: [];
    in-out property <int> nucoder-task-index: 0;
    in-out property <string> nucoder-context: "48k";
    in-out property <bool> nucoder-modal-open: false;
    in-out property <bool> nucoder-pulse: false;
    in-out property <bool> nucoder-perm-web: true;
    in-out property <bool> nucoder-perm-read-outside: false;
    in-out property <bool> nucoder-perm-terminal: true;
    in-out property <bool> nucoder-perm-ftp: true;
    in-out property <bool> nucoder-autopilot: false;
    in-out property <bool> nucoder-sandbox: true;
    in-out property <bool> nucoder-confirm: true;

    callback menu-activated(string);
    callback close-requested();
    callback open-project();
    callback open-file();
    callback new-file();
    callback open-recent(int);
    callback git-refresh();
    callback git-init();
    callback git-stage-all();
    callback git-toggle(string, bool);
    callback git-commit();
    callback git-push();
    callback git-open(string);
    callback git-unstage-all();
    callback git-amend();
    callback git-pull();
    callback git-branch-click();
    callback branch-menu-command(string);
    callback branch-menu-close();
    callback git-diff(string, bool, bool);
    callback diff-close();
    callback diff-open-file();
    callback diff-toggle-stage();
    callback diff-discard();
    // Preferencias.
    callback prefs-dismiss();
    callback prefs-cycle-mono();
    callback prefs-cycle-sans();
    callback prefs-cycle-alpha();
    // Despliegue del proyecto abierto (ver `src/site.rs` y `src/deploy.rs`).
    callback prefs-cycle-transport();
    callback prefs-edit-site(string);
    callback prefs-test-site();
    callback prefs-upload-site();
    callback prefs-ssh-terminal();

    // Sitio de despliegue del proyecto, para el panel de Preferencias.
    in-out property <string> site-transport: "FTP";
    in-out property <string> site-host: "";
    in-out property <string> site-user: "";
    in-out property <string> site-pass: "";
    in-out property <string> site-remote: "";
    in-out property <string> site-local-sub: "";
    in-out property <string> site-include: "";
    in-out property <string> site-script: "";

    // --- módulos: servidor web local y visor de SQLite ---
    // El servidor se prende/apaga desde Preferencias; la URL se ve en el pie.
    in-out property <bool> web-enabled: false;
    in-out property <string> web-url: "";
    in-out property <string> web-port: "8080";
    in-out property <string> web-root: "";
    in-out property <string> web-cors: "*";
    // Visor de SQLite: panel modal con tablas y filas.
    in-out property <bool> sqlite-open: false;
    in-out property <bool> sqlite-module: false;
    in-out property <string> sqlite-db: "";
    in-out property <string> sqlite-tool: "";
    in-out property <[string]> sqlite-tables: [];
    in-out property <int> sqlite-selected: 0;
    in-out property <string> sqlite-header: "";
    in-out property <[string]> sqlite-lines: [];
    in-out property <string> sqlite-note: "";
    in-out property <bool> sqlite-busy: false;

    // Catálogo de skills (Claude/OpenCode/nativos).
    in-out property <bool> skills-open: false;
    in-out property <[IdeSkillRow]> skills-rows: [];
    in-out property <int> skills-selected: 0;
    in-out property <[string]> skills-detail: [];
    in-out property <string> skills-dir: "";
    in-out property <string> skills-header: "";
    in-out property <string> skills-filter: "";
    in-out property <string> skills-note: "";
    in-out property <bool> skills-busy: false;
    in-out property <bool> skills-web: false;

    // Cliente FTP (módulo modal).
    in-out property <bool> ftp-open: false;
    in-out property <string> ftp-transport: "FTP";
    in-out property <string> ftp-host: "";
    in-out property <string> ftp-port: "21";
    in-out property <string> ftp-user: "";
    in-out property <string> ftp-pass: "";
    in-out property <string> ftp-path: "/";
    in-out property <[IdeFtpEntry]> ftp-entries: [];
    in-out property <int> ftp-selected: 0;
    in-out property <bool> ftp-busy: false;
    in-out property <string> ftp-note: "";
    in-out property <bool> ftp-error: false;
    in-out property <string> ftp-pending-delete: "";
    in-out property <string> ftp-filter: "";

    callback toggle-web();
    callback edit-web-port();
    callback edit-web-root();
    callback edit-web-cors();
    callback toggle-sqlite-module();
    // --- pantalla de configuración (maneja por datos: `Ide::settings_rows`) ---
    in-out property <bool> settings-open: false;
    in-out property <[IdeSetting]> settings-rows: [];
    in-out property <[string]> settings-sections: [];
    in-out property <int> settings-section: 0;
    callback settings-changed(string, string);
    callback settings-activated(string);
    callback settings-section-selected(int);
    callback settings-dismiss();
    // Proveedores de NuCoder (CRUD sobre su config propia).
    in-out property <bool> provider-open: false;
    in-out property <string> provider-id: "";
    in-out property <string> provider-name: "";
    in-out property <bool> provider-free-only: false;
    in-out property <string> provider-base-url: "";
    in-out property <string> provider-api-key: "";
    in-out property <string> provider-models: "";
    in-out property <string> provider-note: "";
    in-out property <bool> provider-new: true;
    callback provider-changed(string, string);
    callback provider-save();
    callback provider-delete();
    callback provider-cancel();
    callback sqlite-open-panel();
    callback ftp-close();
    callback ftp-cycle-transport();
    callback ftp-edited(string, string);
    callback ftp-use-site();
    callback ftp-up();
    callback ftp-refresh();
    callback ftp-open-entry(int);
    callback ftp-delete-entry(int);
    callback ftp-confirm-delete();
    callback ftp-cancel-delete();
    callback ftp-upload();
    callback ftp-mkdir(string);
    callback ftp-filter-changed(string);
    callback sqlite-dismiss();
    callback sqlite-pick-db();
    callback sqlite-refresh();
    callback sqlite-table-selected(int);
    callback skills-dismiss();
    callback skills-refresh();
    callback skills-pick(int);
    callback skills-toggle();
    callback skills-install();
    callback skills-cook();
    callback skills-delete();
    callback skills-web-toggle();
    callback prefs-font-smaller();
    callback prefs-font-bigger();
    callback prefs-cycle-accent();
    callback prefs-cycle-tab();
    callback prefs-toggle-spaces();
    callback prefs-toggle-build();
    callback prefs-capture(string);
    // Acerca de.
    callback about-close();
    callback palette-accept(int);
    callback palette-dismiss();
    callback terminal-key(string, bool, bool, bool);
    callback terminal-resize(length, length);
    callback terminal-scroll(length);
    callback terminal-selection-start(length, length);
    callback terminal-selection-update(length, length);
    callback terminal-selection-end();
    callback terminal-mouse(int, int, length, length);
    // Botón del medio en la terminal: pegar el portapapeles.
    callback terminal-paste();
    callback session-selected(int);
    callback new-session();
    callback close-session();
    callback split-terminal();
    callback terminal-focus-pane(int);
    // Menú "Ver": mostrar/ocultar regiones y cambiar el dock de cada panel.
    callback toggle-region(int);
    callback cycle-dock(int);
    callback menu-close();
    callback menu-command(string);
    // Diálogo de cambios sin guardar.
    callback confirm-save();
    callback confirm-discard();
    callback confirm-cancel();
    // Explorador: menú contextual y filtro.
    callback explorer-context-opened(int);
    callback explorer-context-command(string);
    callback explorer-context-close();
    // Terminales: menú contextual (clic derecho).
    callback term-context-opened(int);
    callback term-context-command(string);
    callback term-context-close();
    callback explorer-refresh();
    callback explorer-toggle-generated();
    // Diálogo de entrada de texto.
    callback prompt-accept();
    callback prompt-cancel();
    // Buscar en el proyecto.
    callback search-dismiss();
    callback search-toggle-case();
    callback search-toggle-regex();
    callback search-toggle-replace();
    callback search-replace-all();
    callback search-accept(int);
    callback search-focus(bool);
    // Diálogo de dos botones (eliminar).
    callback ask-accept();
    callback ask-cancel();
    // Explorador y editor.
    callback node-activated(int);
    callback tab-activated(int);
    callback tab-closed(int);
    callback editor-key(string, bool, bool);
    callback editor-cursor(length, length, length);
    callback editor-extend(length, length, length);
    // Búsqueda del editor.
    callback find-next();
    callback find-prev();
    callback find-close();
    callback find-toggle-replace();
    callback find-toggle-case();
    callback find-toggle-word();
    callback find-toggle-regex();
    callback find-toggle-selection();
    callback find-focus(bool);
    callback replace-one();
    callback replace-all();
    // Vista previa de Markdown.
    callback preview-toggle();
    // Zoom del visor de imagen.
    callback image-zoom-in();
    callback image-zoom-out();
    callback image-zoom-reset();
    // Esquema: saltar a una línea.
    callback goto-line(int);
    callback editor-complete-pick(int);
    // Panel del agente.
    callback agent-key(string, bool, bool, bool);
    callback agent-resize(length, length);
    callback agent-scroll(length);
    callback agent-selection-start(length, length);
    callback agent-selection-update(length, length);
    callback agent-selection-end();
    callback agent-mouse(int, int, length, length);
    // Botón del medio en el panel del agente: pegar el portapapeles.
    callback agent-paste();
    // Panel de NuCoder (chat del agente).
    callback nucoder-send(string);
    callback nucoder-cancel();
    callback nucoder-answer(bool);
    callback nucoder-toggle-auto();
    callback nucoder-toggle-free();
    callback nucoder-clear();
    callback nucoder-model-picked(int);
    callback nucoder-model-ping(int);
    callback nucoder-model-ping-all();
    callback nucoder-model-row-use(int);
    callback nucoder-model-filter-changed(string);
    callback nucoder-model-sort-cycle();
    callback nucoder-model-sync();
    callback nucoder-task-picked(int);
    callback nucoder-attach-image();
    callback nucoder-clear-images();
    callback nucoder-cycle-context();
    callback nucoder-toggle-perm(string);
    callback nucoder-copy(string);
    // Atajo global capturado a nivel ventana (para que funcione con el foco en
    // el input del chat, que no es un `FocusScope`).
    callback global-key(string, bool, bool, bool);

    // La terminal recibe el teclado apenas se abre la ventana: sólo hay un
    // elemento focusable y éste es el dueño natural del foco.
    forward-focus: terminal;

    // Mide el ancho real de una celda monoespaciada (32 'M' a 12 px). Se usa
    // para dimensionar el PTY y ubicar la grilla de las terminales.
    measure := Text {
        x: -1000px;
        y: 0;
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: IdeTheme.mono;
        font-size: 12px;
        width: self.preferred-width;
        height: self.preferred-height;
        opacity: 0;
    }
    // La barra superior publica el ancho real de una celda monoespaciada
    // (medido en `measure`); Rust lo lee para dimensionar el PTY.
    out property <length> cell-width: measure.width > 1px ? measure.width / 32 : 7.2px;

    // --- geometría derivada (todo relativo al área de contenido) ---
    private property <length> view-menu-x: topbar.view-menu-x;
    // Dónde anclar el desplegable abierto, según cuál sea.
    private property <length> menu-anchor: root.menu-open == "file" ? topbar.file-menu-x
        : root.menu-open == "edit" ? topbar.edit-menu-x
        : root.menu-open == "agent" ? topbar.agent-menu-x
        : root.menu-open == "help" ? topbar.help-menu-x
        : topbar.view-menu-x;
    private property <length> content-w: self.width;
    private property <length> content-h: max(0px, self.height - IdeTheme.topbar-h - IdeTheme.statusbar-h);

    // Cada panel tiene un dock (0 izquierda, 1 derecha, 2 abajo, 3 oculto) y los
    // que comparten región se apilan en el orden 0 Explorador, 1 Agente,
    // 2 Terminal, 3 Git.
    function dock-of(panel: int) -> int {
        return panel == 0 ? root.dock-explorer
             : panel == 1 ? root.dock-agent
             : panel == 2 ? root.dock-terminal
             : root.dock-git;
    }
    function count-in(region: int) -> int {
        return (root.dock-explorer == region ? 1 : 0)
             + (root.dock-agent == region ? 1 : 0)
             + (root.dock-terminal == region ? 1 : 0)
             + (root.dock-git == region ? 1 : 0);
    }
    function index-in(region: int, panel: int) -> int {
        return (panel > 0 && root.dock-explorer == region ? 1 : 0)
             + (panel > 1 && root.dock-agent == region ? 1 : 0)
             + (panel > 2 && root.dock-terminal == region ? 1 : 0);
    }
    function region-shown(region: int) -> bool {
        return region == 0 ? root.show-left : region == 1 ? root.show-right : root.show-bottom;
    }
    function region-visible(region: int) -> bool {
        return root.count-in(region) > 0 && root.region-shown(region);
    }
    function panel-visible(panel: int) -> bool {
        let dock = root.dock-of(panel);
        return dock != 3 && root.region-visible(dock);
    }
    function slot-h(region: int) -> length {
        let n = root.count-in(region);
        if (n <= 0) { return 0px; }
        return (region == 2 ? root.bottom-h : root.content-h) / n;
    }
    function slot-y(region: int, panel: int) -> length {
        let n = root.count-in(region);
        let base = region == 2 ? root.editor-h + root.bottom-gap : 0px;
        if (n <= 0) { return base; }
        return base + (root.index-in(region, panel) * (region == 2 ? root.bottom-h : root.content-h)) / n;
    }
    function panel-x(panel: int) -> length {
        let dock = root.dock-of(panel);
        return dock == 0 ? 0px : dock == 1 ? root.content-w - root.right-w : root.center-x;
    }
    function panel-w(panel: int) -> length {
        let dock = root.dock-of(panel);
        return dock == 0 ? root.left-w : dock == 1 ? root.right-w : root.center-w;
    }

    private property <length> left-w: root.region-visible(0) ? root.content-w * root.left-frac : 0px;
    private property <length> right-w: root.region-visible(1) ? root.content-w * root.right-frac : 0px;
    private property <length> left-gap: root.region-visible(0) ? IdeTheme.splitter : 0px;
    private property <length> right-gap: root.region-visible(1) ? IdeTheme.splitter : 0px;
    private property <length> center-x: root.left-w + root.left-gap;
    private property <length> center-w: max(0px, root.content-w - root.left-w - root.right-w - root.left-gap - root.right-gap);
    private property <length> editor-h: root.region-visible(2) ? root.content-h * (1 - root.bottom-frac) : root.content-h;
    private property <length> bottom-gap: root.region-visible(2) ? IdeTheme.splitter : 0px;
    private property <length> bottom-h: max(0px, root.content-h - root.editor-h - root.bottom-gap);

    // --- arrastrar paneles entre docks (ver ui/ide_dock.slint) ---
    // El puntero llega en coordenadas de ventana; acá se pasan a contenido para
    // poder comparar con las bandas de los docks.
    private property <length> drag-px: DockDrag.px;
    private property <length> drag-py: max(0px, DockDrag.py - IdeTheme.topbar-h);
    // Zona bajo el cursor: 0 izquierda, 1 derecha, 2 abajo, 3 ocultar. La lee
    // Rust al soltar el asa (`DockDrag.on_released`).
    in-out property <int> drop-zone: DockDrag.panel >= 0 ? root.zone-at(root.drag-px, root.drag-py) : -1;

    // Bordes de las bandas de destino. Si la región está visible se usa su
    // franja real; si está apagada se reserva un borde de la ventana, así se la
    // puede volver a encender arrastrando un panel hacia ahí.
    private property <length> zone-left: root.region-visible(0)
        ? root.left-w + IdeTheme.splitter : root.content-w * 0.10;
    private property <length> zone-right: root.region-visible(1)
        ? root.content-w - root.right-w - IdeTheme.splitter : root.content-w * 0.90;
    private property <length> zone-bottom: root.region-visible(2)
        ? root.editor-h + root.bottom-gap - IdeTheme.splitter : root.content-h * 0.82;

    /// Qué banda le toca a un punto del área de contenido. El centro suelto
    /// significa "ocultar".
    function zone-at(px: length, py: length) -> int {
        if (px <= root.zone-left) {
            return 0;
        }
        if (px >= root.zone-right) {
            return 1;
        }
        if (py >= root.zone-bottom) {
            return 2;
        }
        return 3;
    }

    function zone-name(z: int) -> string {
        return z == 0 ? "izquierda" : z == 1 ? "derecha" : z == 2 ? "abajo" : "ocultar";
    }

    // Se soltó el asa: lo atiende Rust (`DockDrag::global().on_released` en
    // `editor::attach`), que lee `drop-zone` y aplica el dock.

    // Qué divisor está bajo el cursor: 0 nada, 1 izquierda, 2 derecha, 3 horizontal.
    // Un divisor sólo cuenta si su región está visible.
    function hit-test(px: length, py: length) -> int {
        if (root.region-visible(0) && px >= root.left-w - 3px && px <= root.left-w + IdeTheme.splitter + 3px) {
            return 1;
        }
        if (root.region-visible(1) && px >= root.content-w - root.right-w - IdeTheme.splitter - 3px && px <= root.content-w - root.right-w + 3px) {
            return 2;
        }
        if (root.region-visible(2) && py >= root.editor-h - 3px && py <= root.editor-h + IdeTheme.splitter + 3px
            && px >= root.center-x && px <= root.center-x + root.center-w) {
            return 3;
        }
        return 0;
    }

    function apply-drag(px: length, py: length) {
        if (root.drag-mode == 1) {
            root.left-frac = min(max(px / root.content-w, 0.10), 0.40);
        } else if (root.drag-mode == 2) {
            root.right-frac = min(max((root.content-w - px) / root.content-w, 0.15), 0.45);
        } else if (root.drag-mode == 3) {
            root.bottom-frac = min(max(1 - py / root.content-h, 0.12), 0.50);
        }
    }

    // --- barra superior ---
    topbar := IdeTopBar {
        x: 0;
        y: 0;
        width: parent.width;
        project: root.project-name;
        active-menu: root.menu-open;
        show-left: root.show-left;
        show-right: root.show-right;
        show-bottom: root.show-bottom;
        menu-activated(label) => { root.menu-activated(label); }
        toggle-region(kind) => { root.toggle-region(kind); }
        project-clicked => { root.open-project(); }
        close-requested => { root.close-requested(); }
    }

    // --- barra inferior ---
    IdeStatusBar {
        x: 0;
        y: parent.height - IdeTheme.statusbar-h;
        width: parent.width;
        branch: root.git-branch;
        language: root.language;
        encoding: "UTF-8";
        line: root.active-line;
        column: root.active-column;
        diagnostics: root.diagnostics;
        cpu: root.cpu-percent;
        ram: root.ram-percent;
        elevated: root.elevated;
    }

    // --- área de contenido ---
    Rectangle {
        x: 0;
        y: IdeTheme.topbar-h;
        width: parent.width;
        height: root.content-h;
        background: IdeTheme.bg;

        // Zona sensible de los divisores (detrás de los paneles).
        drag := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.drag-mode = root.hit-test(self.mouse-x, self.mouse-y);
                    root.apply-drag(self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-mode = 0;
                }
            }

            moved => { root.apply-drag(self.mouse-x, self.mouse-y); }

            mouse-cursor: root.hit-test(self.mouse-x, self.mouse-y) == 3 ? MouseCursor.ns-resize
                : root.hit-test(self.mouse-x, self.mouse-y) != 0 ? MouseCursor.ew-resize
                : MouseCursor.default;

            // Guías visuales de los divisores (viven en los huecos entre paneles).
            // Sólo se ven si el panel que dividen está presente.
            Rectangle {
                x: root.left-w + IdeTheme.splitter / 2 - 1px;
                y: 0;
                width: 2px;
                height: root.content-h;
                visible: root.region-visible(0);
                background: root.drag-mode == 1 ? IdeTheme.mint : transparent;
            }
            Rectangle {
                x: root.content-w - root.right-w - IdeTheme.splitter / 2 - 1px;
                y: 0;
                width: 2px;
                height: root.content-h;
                visible: root.region-visible(1);
                background: root.drag-mode == 2 ? IdeTheme.mint : transparent;
            }
            Rectangle {
                x: root.center-x;
                y: root.editor-h + IdeTheme.splitter / 2 - 1px;
                width: root.center-w;
                height: 2px;
                visible: root.region-visible(2);
                background: root.drag-mode == 3 ? IdeTheme.mint : transparent;
            }
        }

        // --- panel: explorador (dock configurable) ---
        explorer := IdeExplorer {
            x: root.panel-x(0);
            y: root.slot-y(root.dock-of(0), 0);
            width: root.panel-w(0);
            height: root.slot-h(root.dock-of(0));
            visible: root.panel-visible(0);
            nodes: root.tree-nodes;
            selected-index: root.explorer-selected;
            show-generated: root.explorer-show-generated;
            node-clicked(i) => { root.explorer-selected = i; root.node-activated(i); editor.focus(); }
            context-opened(i) => { root.explorer-context-opened(i); }
            refresh => { root.explorer-refresh(); }
            toggle-generated => { root.explorer-toggle-generated(); }
        }

        // --- columna central: editor ---
        editor := IdeEditor {
            x: root.center-x;
            y: 0;
            width: root.center-w;
            height: root.editor-h;
            tabs: root.editor-tabs;
            active-tab: root.active-tab;
            breadcrumb: root.breadcrumb;
            lines: root.code-lines;
            active-line: root.active-line;
            find-open: root.find-open;
            find-replace-open: root.find-replace-open;
            find-query: root.find-query;
            find-replace: root.find-replace;
            find-info: root.find-info;
            find-focus-replace: root.find-focus-replace;
            find-case: root.find-case;
            find-whole-word: root.find-whole-word;
            find-regex: root.find-regex;
            find-in-selection: root.find-in-selection;
            find-query-before: root.find-query-before;
            find-query-after: root.find-query-after;
            find-replace-before: root.find-replace-before;
            find-replace-after: root.find-replace-after;
            show-image: root.show-image;
            active-image: root.active-image;
            image-zoom: root.image-zoom;
            show-preview: root.show-preview;
            preview-styled: root.preview-styled;
            is-markdown: root.is-markdown;
            outline: root.outline;
            complete-open: root.editor-complete-open;
            complete-items: root.editor-complete-items;
            complete-selected: root.editor-complete-selected;
            welcome: root.welcome;
            welcome-recent: root.welcome-recent;
            tab-selected(i) => { root.tab-activated(i); }
            tab-closed(i) => { root.tab-closed(i); }
            key-input(text, ctrl, shift) => { root.editor-key(text, ctrl, shift); }
            cursor-to(y, x, scroll) => { root.editor-cursor(y, x, scroll); }
            extend-to(y, x, scroll) => { root.editor-extend(y, x, scroll); }
            find-next => { root.find-next(); }
            find-prev => { root.find-prev(); }
            find-close => { root.find-close(); }
            find-toggle-replace => { root.find-toggle-replace(); }
            find-toggle-case => { root.find-toggle-case(); }
            find-toggle-word => { root.find-toggle-word(); }
            find-toggle-regex => { root.find-toggle-regex(); }
            find-toggle-selection => { root.find-toggle-selection(); }
            find-focus(replace) => { root.find-focus(replace); }
            replace-one => { root.replace-one(); }
            replace-all => { root.replace-all(); }
            preview-toggle => { root.preview-toggle(); }
            image-zoom-in => { root.image-zoom-in(); }
            image-zoom-out => { root.image-zoom-out(); }
            image-zoom-reset => { root.image-zoom-reset(); }
            goto-line(line) => { root.goto-line(line); }
            complete-pick(i) => { root.editor-complete-pick(i); }
            open-project => { root.open-project(); }
            open-file => { root.open-file(); }
            new-file => { root.new-file(); }
            open-recent(i) => { root.open-recent(i); }
        }

        // --- panel: terminal local (dock configurable) ---
        terminal := IdeTerminal {
            x: root.panel-x(2);
            y: root.slot-y(root.dock-of(2), 2);
            width: root.panel-w(2);
            height: root.slot-h(root.dock-of(2));
            visible: root.panel-visible(2);
            sessions: root.term-sessions;
            active-session: root.active-session;
            lines: root.term-lines;
            scroll-total: root.term-scroll-total;
            scroll-pos: root.term-scroll-pos;
            scroll-thumb: root.term-scroll-thumb;
            cell-width: root.cell-width;
            split-view: root.term-split;
            lines-2: root.term-lines-2;
            mouse-tracking: root.term-mouse;
            mouse-tracking-2: root.term-mouse-2;
            mouse-report(k, b, y, x) => { root.terminal-mouse(k, b, y, x); }
            focus-pane(p) => { root.terminal-focus-pane(p); }
            session-selected(i) => { root.session-selected(i); }
            key-input(text, ctrl, shift, alt) => { root.terminal-key(text, ctrl, shift, alt); }
            resized(w, h) => { root.terminal-resize(w, h); }
            scrolled(dy) => { root.terminal-scroll(dy); }
            selection-start(y, x) => { root.terminal-selection-start(y, x); }
            selection-update(y, x) => { root.terminal-selection-update(y, x); }
            selection-end => { root.terminal-selection-end(); }
            paste-requested => { root.terminal-paste(); }
            context-opened(x, y) => {
                root.term-context-x = root.panel-x(2) + x;
                root.term-context-y = IdeTheme.topbar-h + root.slot-y(root.dock-of(2), 2) + y;
                root.term-context-opened(0);
            }
            new-session => { root.new-session(); }
            close => { root.close-session(); }
            split => { root.split-terminal(); }
        }

        // --- panel: agente (chat nativo de NuCoder o terminal) ---
        if root.nucoder-open: IdeNucoder {
            x: root.panel-x(1);
            y: root.slot-y(root.dock-of(1), 1);
            width: root.panel-w(1);
            height: root.slot-h(root.dock-of(1));
            visible: root.panel-visible(1);
            messages: root.nucoder-messages;
            model: root.nucoder-model;
            task: root.nucoder-task;
            free-only: root.nucoder-free;
            running: root.nucoder-running;
            auto-approve: root.nucoder-auto-approve;
            connected: root.nucoder-connected;
            image-count: root.nucoder-images;
            models: root.nucoder-models;
            model-index: root.nucoder-model-index;
            model-rows: root.nucoder-model-rows;
            model-filter <=> root.nucoder-model-filter;
            model-sort: root.nucoder-model-sort;
            tasks: root.nucoder-tasks;
            task-index: root.nucoder-task-index;
            context: root.nucoder-context;
            modal-open: root.nucoder-modal-open;
            pulse: root.nucoder-pulse;
            perm-web: root.nucoder-perm-web;
            perm-read-outside: root.nucoder-perm-read-outside;
            perm-terminal: root.nucoder-perm-terminal;
            perm-ftp: root.nucoder-perm-ftp;
            autopilot: root.nucoder-autopilot;
            sandbox: root.nucoder-sandbox;
            confirm: root.nucoder-confirm;
            pending: root.nucoder-pending;
            pending-title: root.nucoder-pending-title;
            pending-detail: root.nucoder-pending-detail;
            draft <=> root.nucoder-draft;
            send(text) => { root.nucoder-draft = ""; root.nucoder-send(text); }
            cancel => { root.nucoder-cancel(); }
            answer(ok) => { root.nucoder-answer(ok); }
            toggle-auto-approve => { root.nucoder-toggle-auto(); }
            toggle-free => { root.nucoder-toggle-free(); }
            clear => { root.nucoder-clear(); }
            model-picked(index) => { root.nucoder-model-picked(index); }
            model-ping(i) => { root.nucoder-model-ping(i); }
            model-ping-all => { root.nucoder-model-ping-all(); }
            model-row-use(i) => { root.nucoder-model-row-use(i); }
            model-filter-changed(v) => { root.nucoder-model-filter-changed(v); }
            model-sort-cycle => { root.nucoder-model-sort-cycle(); }
            model-sync => { root.nucoder-model-sync(); }
            task-picked(index) => { root.nucoder-task-picked(index); }
            attach-image => { root.nucoder-attach-image(); }
            clear-images => { root.nucoder-clear-images(); }
            cycle-context => { root.nucoder-cycle-context(); }
            toggle-perm(which) => { root.nucoder-toggle-perm(which); }
            copy-text(t) => { root.nucoder-copy(t); }
            global-key(text, ctrl, shift, alt) => { root.global-key(text, ctrl, shift, alt); }
        }

        if !root.nucoder-open: IdeAgent {
            x: root.panel-x(1);
            y: root.slot-y(root.dock-of(1), 1);
            width: root.panel-w(1);
            height: root.slot-h(root.dock-of(1));
            visible: root.panel-visible(1);
            connected: root.agent-connected;
            lines: root.agent-lines;
            scroll-total: root.agent-scroll-total;
            scroll-pos: root.agent-scroll-pos;
            scroll-thumb: root.agent-scroll-thumb;
            cell-width: root.cell-width;
            mouse-tracking: root.agent-mouse-tracking;
            key-input(text, ctrl, shift, alt) => { root.agent-key(text, ctrl, shift, alt); }
            resized(w, h) => { root.agent-resize(w, h); }
            scrolled(dy) => { root.agent-scroll(dy); }
            selection-start(y, x) => { root.agent-selection-start(y, x); }
            selection-update(y, x) => { root.agent-selection-update(y, x); }
            selection-end => { root.agent-selection-end(); }
            mouse-report(k, b, y, x) => { root.agent-mouse(k, b, y, x); }
            paste-requested => { root.agent-paste(); }
            context-opened(x, y) => {
                root.term-context-x = root.panel-x(1) + x;
                root.term-context-y = IdeTheme.topbar-h + root.slot-y(root.dock-of(1), 1) + y;
                root.term-context-opened(1);
            }
        }

        // --- panel: control de código (Git) (dock configurable) ---
        git-panel := IdeGit {
            x: root.panel-x(3);
            y: root.slot-y(root.dock-of(3), 3);
            width: root.panel-w(3);
            height: root.slot-h(root.dock-of(3));
            visible: root.panel-visible(3);
            branch: root.git-branch;
            sync-info: root.git-sync-info;
            is-repo: root.git-repo;
            busy: root.git-busy;
            note: root.git-note;
            error: root.git-error;
            staged: root.git-staged;
            changes: root.git-changes;
            message <=> root.git-message;
            refresh => { root.git-refresh(); }
            init-repo => { root.git-init(); }
            stage-all => { root.git-stage-all(); }
            unstage-all => { root.git-unstage-all(); }
            toggle(path, staged) => { root.git-toggle(path, staged); }
            commit => { root.git-commit(); }
            amend => { root.git-amend(); }
            pull => { root.git-pull(); }
            push => { root.git-push(); }
            branch-click => { root.git-branch-click(); }
            open-file(path) => { root.git-open(path); }
            diff(path, staged, untracked) => { root.git-diff(path, staged, untracked); }
        }

        // --- capa de arrastre de paneles ---
        // Mientras se arrastra una cabecera se resaltan las bandas de destino y
        // una etiqueta sigue al cursor. No tiene TouchArea: no come eventos, el
        // gesto lo sigue teniendo el asa de la cabecera.
        if DockDrag.panel >= 0: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #00000055;

            // Banda izquierda.
            Rectangle {
                x: 0px;
                y: 0px;
                width: root.zone-left;
                height: parent.height;
                background: root.drop-zone == 0 ? #83d9cb33 : #83d9cb14;
                border-width: root.drop-zone == 0 ? 2px : 1px;
                border-color: IdeTheme.mint;

                Text {
                    x: 0px;
                    y: 12px;
                    width: parent.width;
                    text: @tr("Izquierda");
                    color: IdeTheme.text;
                    font-family: IdeTheme.sans;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // Banda derecha.
            Rectangle {
                x: root.zone-right;
                y: 0px;
                width: root.content-w - root.zone-right;
                height: parent.height;
                background: root.drop-zone == 1 ? #83d9cb33 : #83d9cb14;
                border-width: root.drop-zone == 1 ? 2px : 1px;
                border-color: IdeTheme.mint;

                Text {
                    x: 0px;
                    y: 12px;
                    width: parent.width;
                    text: @tr("Derecha");
                    color: IdeTheme.text;
                    font-family: IdeTheme.sans;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // Banda inferior.
            Rectangle {
                x: root.center-x;
                y: root.zone-bottom;
                width: root.center-w;
                height: parent.height - root.zone-bottom;
                background: root.drop-zone == 2 ? #83d9cb33 : #83d9cb14;
                border-width: root.drop-zone == 2 ? 2px : 1px;
                border-color: IdeTheme.mint;

                Text {
                    x: 0px;
                    y: 6px;
                    width: parent.width;
                    text: @tr("Abajo");
                    color: IdeTheme.text;
                    font-family: IdeTheme.sans;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // Centro: soltar acá oculta el panel.
            Rectangle {
                x: root.center-x;
                y: 0px;
                width: root.center-w;
                height: root.editor-h;
                visible: root.drop-zone == 3;
                border-width: 2px;
                border-color: IdeTheme.amber;
                border-radius: IdeTheme.radius;
                background: #e7ba7022;

                Text {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: @tr("Soltar acá oculta el panel");
                    color: IdeTheme.amber;
                    font-family: IdeTheme.sans;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            // Etiqueta que sigue al puntero.
            Rectangle {
                x: min(max(root.drag-px + 14px, 0px), parent.width - 190px);
                y: min(max(root.drag-py - 46px, 0px), parent.height - 26px);
                width: 190px;
                height: 24px;
                border-radius: IdeTheme.radius-sm;
                background: IdeTheme.control-hi;
                border-width: 1px;
                border-color: IdeTheme.mint;

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: DockDrag.label + " → " + root.zone-name(root.drop-zone);
                    color: IdeTheme.text;
                    font-family: IdeTheme.sans;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // --- capa que cierra el menú abierto al hacer clic fuera ---
    if root.menu-open != "": Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.menu-close(); }
        }
    }

    // --- desplegable de "Ver" (paneles) ---
    if root.menu-open == "view": IdeViewMenu {
        x: root.menu-anchor;
        y: IdeTheme.topbar-h;
        dock-explorer: root.dock-explorer;
        dock-agent: root.dock-agent;
        dock-terminal: root.dock-terminal;
        dock-git: root.dock-git;
        cycle-dock(kind) => { root.cycle-dock(kind); }
    }

    // --- desplegable de Archivo / Editar / Agente / Ayuda ---
    if root.menu-open == "file" || root.menu-open == "edit" || root.menu-open == "agent" || root.menu-open == "help": IdeMenu {
        x: root.menu-anchor;
        y: IdeTheme.topbar-h;
        items: root.menu-items;
        activated(id) => { root.menu-command(id); }
    }

    // --- menú contextual del explorador ---
    if root.explorer-context-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.explorer-context-close(); }
        }
    }
    if root.explorer-context-open: IdeMenu {
        x: root.panel-x(0) + explorer.context-x;
        y: IdeTheme.topbar-h + root.slot-y(root.dock-of(0), 0) + explorer.context-y;
        width: 220px;
        items: root.explorer-context-items;
        activated(id) => { root.explorer-context-command(id); }
    }

    // --- menú de ramas de Git ---
    if root.branch-menu-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.branch-menu-close(); }
        }
    }
    if root.branch-menu-open: IdeMenu {
        x: root.panel-x(3) + git-panel.branch-menu-x;
        y: IdeTheme.topbar-h + root.slot-y(root.dock-of(3), 3) + git-panel.branch-menu-y;
        width: 200px;
        items: root.branch-menu-items;
        activated(id) => { root.branch-menu-command(id); }
    }

    // --- menú contextual de las terminales (clic derecho) ---
    if root.term-context-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.term-context-close(); }
        }
    }
    if root.term-context-open: IdeMenu {
        x: root.term-context-x;
        y: root.term-context-y;
        width: 220px;
        items: root.term-context-items;
        activated(id) => { root.term-context-command(id); }
    }

    // --- visor de diff de Git ---
    if root.diff-open: IdeDiff {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.diff-title;
        note: root.diff-note;
        error: root.diff-error;
        lines: root.diff-lines;
        staged: root.diff-staged;
        busy: root.diff-busy;
        close => { root.diff-close(); }
        open-file => { root.diff-open-file(); }
        toggle-stage => { root.diff-toggle-stage(); }
        discard => { root.diff-discard(); }
    }

    // --- preferencias ---
    if root.settings-open: IdeSettings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        rows: root.settings-rows;
        sections: root.settings-sections;
        section: root.settings-section;
        changed(id, value) => { root.settings-changed(id, value); }
        activated(id) => { root.settings-activated(id); }
        section-selected(i) => { root.settings-section-selected(i); }
        dismiss => { root.settings-dismiss(); }
    }

    // --- formulario de proveedores de NuCoder (encima de Configuración) ---
    if root.provider-open: IdeProvider {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        field-id: root.provider-id;
        field-name: root.provider-name;
        field-free-only: root.provider-free-only;
        field-base-url: root.provider-base-url;
        field-api-key: root.provider-api-key;
        field-models: root.provider-models;
        is-new: root.provider-new;
        note: root.provider-note;
        changed(i, v) => { root.provider-changed(i, v); }
        save => { root.provider-save(); }
        delete => { root.provider-delete(); }
        cancel => { root.provider-cancel(); }
    }

    // --- módulo: visor de SQLite ---
    if root.sqlite-open: IdeSqlite {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        db: root.sqlite-db;
        tool: root.sqlite-tool;
        tables: root.sqlite-tables;
        selected: root.sqlite-selected;
        header: root.sqlite-header;
        lines: root.sqlite-lines;
        note: root.sqlite-note;
        busy: root.sqlite-busy;
        table-selected(i) => { root.sqlite-table-selected(i); }
        pick-db => { root.sqlite-pick-db(); }
        refresh => { root.sqlite-refresh(); }
        dismiss => { root.sqlite-dismiss(); }
    }

    // --- catálogo de skills (Claude/OpenCode/nativos) ---
    if root.skills-open: IdeSkills {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        rows: root.skills-rows;
        selected: root.skills-selected;
        detail: root.skills-detail;
        dir: root.skills-dir;
        header: root.skills-header;
        filter: root.skills-filter;
        note: root.skills-note;
        busy: root.skills-busy;
        web: root.skills-web;
        skill-selected(i) => { root.skills-pick(i); }
        toggle => { root.skills-toggle(); }
        refresh => { root.skills-refresh(); }
        install-requested => { root.skills-install(); }
        cook-requested => { root.skills-cook(); }
        delete-requested => { root.skills-delete(); }
        web-toggle => { root.skills-web-toggle(); }
        dismiss => { root.skills-dismiss(); }
    }

    // --- módulo: cliente FTP ---
    if root.ftp-open: IdeFtp {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        transport: root.ftp-transport;
        host <=> root.ftp-host;
        port <=> root.ftp-port;
        user <=> root.ftp-user;
        pass <=> root.ftp-pass;
        path: root.ftp-path;
        entries: root.ftp-entries;
        selected: root.ftp-selected;
        busy: root.ftp-busy;
        note: root.ftp-note;
        error: root.ftp-error;
        pending-delete: root.ftp-pending-delete;
        filter <=> root.ftp-filter;
        close => { root.ftp-close(); }
        cycle-transport => { root.ftp-cycle-transport(); }
        edited(field, value) => { root.ftp-edited(field, value); }
        use-project-site => { root.ftp-use-site(); }
        up => { root.ftp-up(); }
        refresh => { root.ftp-refresh(); }
        open-entry(i) => { root.ftp-open-entry(i); }
        delete-entry(i) => { root.ftp-delete-entry(i); }
        confirm-delete => { root.ftp-confirm-delete(); }
        cancel-delete => { root.ftp-cancel-delete(); }
        upload => { root.ftp-upload(); }
        mkdir(name) => { root.ftp-mkdir(name); }
        filter-changed(v) => { root.ftp-filter-changed(v); }
    }

    // --- acerca de ---
    if root.about-open: IdeAbout {        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        version: root.about-version;
        dismiss => { root.about-close(); }
    }

    // --- buscar en el proyecto (encima de los paneles) ---
    if root.search-open: IdeSearch {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        query-before: root.search-query-before;
        query-after: root.search-query-after;
        replace-before: root.search-replace-before;
        replace-after: root.search-replace-after;
        replace-open: root.search-replace-open;
        case: root.search-case;
        regex: root.search-regex;
        focus-replace: root.search-focus-replace;
        searching: root.search-searching;
        info: root.search-info;
        hits: root.search-hits;
        selected: root.search-selected;
        dismiss => { root.search-dismiss(); }
        toggle-case => { root.search-toggle-case(); }
        toggle-regex => { root.search-toggle-regex(); }
        toggle-replace => { root.search-toggle-replace(); }
        replace-all => { root.search-replace-all(); }
        accept(i) => { root.search-accept(i); }
        focus-field(replace) => { root.search-focus(replace); }
    }

    // --- diálogo de cambios sin guardar (encima de todo) ---
    if root.confirm-open: IdeConfirm {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.confirm-title;
        message: root.confirm-message;
        save => { root.confirm-save(); }
        discard => { root.confirm-discard(); }
        cancel => { root.confirm-cancel(); }
    }

    // --- diálogo de entrada de texto ---
    if root.prompt-open: IdePrompt {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.prompt-title;
        text: root.prompt-text;
        placeholder: root.prompt-placeholder;
        accept => { root.prompt-accept(); }
        cancel => { root.prompt-cancel(); }
    }

    // --- diálogo de dos botones (eliminar) ---
    if root.ask-open: IdeAsk {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.ask-title;
        message: root.ask-message;
        accept-label: root.ask-accept-label;
        danger: root.ask-danger;
        accept => { root.ask-accept(); }
        cancel => { root.ask-cancel(); }
    }

    // --- paleta de comandos / buscador de archivos (encima de todo) ---
    if root.palette-open: IdePalette {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.palette-title;
        query: root.palette-query;
        items: root.palette-items;
        selected: root.palette-selected;
        accept(i) => { root.palette-accept(i); }
        dismiss => { root.palette-dismiss(); }
    }

    // =======================================================================
    // Datos ilustrativos
    // =======================================================================

    in property <[IdeTreeNode]> tree-nodes: [
        { depth: 0, label: "coquito", kind: 2 },
        { depth: 1, label: "src", kind: 2 },
        { depth: 2, label: "main.spasm", kind: 0 },
        { depth: 2, label: "memory.spasm", kind: 0 },
        { depth: 1, label: "runtime", kind: 2 },
        { depth: 2, label: "memory.spasm", kind: 0 },
        { depth: 2, label: "io.spasm", kind: 0 },
        { depth: 1, label: "ui", kind: 2 },
        { depth: 2, label: "app.slint", kind: 0 },
        { depth: 1, label: "examples", kind: 1 },
        { depth: 2, label: "hello.spasm", kind: 0 },
        { depth: 2, label: "demo.spasm", kind: 0 },
        { depth: 1, label: "config.toml", kind: 3 },
    ];

    in property <[IdeTab]> editor-tabs: [];

    in property <[string]> breadcrumb: ["src", "main.spasm"];

    // La llena Rust al abrir archivos; la bienvenida se dibuja aparte.
    in property <[IdeCodeLine]> code-lines: [];

    in property <[string]> term-sessions: ["bash", "build"];

    // La pantalla real la llena Rust; arranca vacía.
    in property <[TermLine]> term-lines: [];

    // La TUI del agente también la llena Rust.
    in property <[TermLine]> agent-lines: [];
}
