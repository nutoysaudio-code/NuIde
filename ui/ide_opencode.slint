import { IdeTheme } from "ide_theme.slint";
import { TermLine } from "ide_types.slint";
import { TerminalScreen } from "ide_terminal.slint";
import { DockHandle } from "ide_dock.slint";

// Panel derecho: la TUI de OpenCode CLI corriendo en un PTY (sin burbujas de
// chat). Reutiliza `TerminalScreen`: mismo emulador, scrollback y selección que
// la terminal local.
//
// Hereda de `FocusScope` para recibir el teclado cuando se lo clickea. Como
// `FocusScope` no tiene superficie propia, lo visual vive en el `Rectangle`
// interno.
export component IdeOpenCode inherits FocusScope {
    in property <bool> connected: true;
    in property <[TermLine]> lines: [];
    in property <int> scroll-total: 0;
    in property <float> scroll-pos: 1.0;
    in property <float> scroll-thumb: 1.0;
    in property <length> cell-width: 7.2px;
    // El proceso pidió mouse reporting.
    in property <bool> mouse-tracking: false;
    callback key-input(string, bool, bool, bool);
    // Tamaño del área de pantalla en píxeles, para dimensionar el PTY.
    callback resized(length, length);
    callback scrolled(length);
    callback selection-start(length, length);
    callback selection-update(length, length);
    callback selection-end();
    // Evento de mouse reenviado al proceso (kind, button, y, x).
    callback mouse-report(int, int, length, length);
    // Pegar el portapapeles en el agente (botón del medio).
    callback paste-requested();
    // Clic derecho: (x, y) relativos a la terminal, para abrir el menú contextual.
    callback context-opened(length, length);

    focus-on-click: true;

    key-pressed(event) => {
        root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
        accept
    }

    // La ficha de sesión ocupa los 104 px de arriba (34 de encabezado + 70 de
    // ficha, que ahora incluye la pista de copiar/pegar).
    // Solo encabezado superior.
    private property <length> screen-top: 34px;

    function report-size() {
        root.resized(self.width, max(0px, self.height - root.screen-top));
    }

    changed width => { root.report-size(); }
    changed height => { root.report-size(); }

    // --- superficie visual ---
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: IdeTheme.panel;
        // Opacidad de la superficie del panel (Preferencias → Opacidad).
        opacity: IdeTheme.panel-alpha;
        border-width: IdeTheme.hairline;
        border-color: transparent;
        border-radius: IdeTheme.radius;
        clip: true;

        // --- encabezado con estado de conexión ---
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 34px;
            background: IdeTheme.bg;

            // Asa para arrastrar el panel a otro dock (ver ui/ide_dock.slint).
            DockHandle {
                x: 0;
                y: 0;
                height: parent.height;
                panel: 1;
            }

            HorizontalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Text {
                    text: @tr("OPENCODE CLI");
                    color: IdeTheme.text-dim;
                    font-family: IdeTheme.sans;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1.6px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.connected ? IdeTheme.online : IdeTheme.del;
                }

                Text {
                    text: root.connected ? "Conectado" : "Desconectado";
                    color: root.connected ? IdeTheme.online : IdeTheme.del;
                    font-family: IdeTheme.sans;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - IdeTheme.hairline;
                width: parent.width;
                height: IdeTheme.hairline;
                background: IdeTheme.border-faint;
            }
        }

        // --- ficha de sesión ---
        // --- pantalla de la TUI (opencode) ---
        TerminalScreen {
            x: 0;
            y: root.screen-top;
            width: parent.width;
            height: parent.height - root.screen-top;
            lines: root.lines;
            scroll-total: root.scroll-total;
            scroll-pos: root.scroll-pos;
            scroll-thumb: root.scroll-thumb;
            cell-width: root.cell-width;
            mouse-tracking: root.mouse-tracking;
            selection-start(y, x) => { root.focus(); root.selection-start(y, x); }
            selection-update(y, x) => { root.selection-update(y, x); }
            selection-end => { root.selection-end(); }
            scrolled(dy) => { root.scrolled(dy); }
            mouse-report(k, b, y, x) => { root.focus(); root.mouse-report(k, b, y, x); }
            paste-requested => { root.focus(); root.paste-requested(); }
            context-requested(y, x) => { root.focus(); root.context-opened(x, root.screen-top + y); }
        }
    }
}
