import { IdeTheme } from "ide_theme.slint";
import { TipContent } from "ide_tooltip.slint";

// Elemento de menú de la barra superior.
component IdeMenuItem inherits Rectangle {
    in property <string> label: "Archivo";
    in property <bool> active: false;
    // Texto del tooltip al pasar el cursor (qué abre este menú).
    in property <string> tip: "";
    callback activated();

    height: 24px;
    width: menu-text.width + 18px;
    border-radius: IdeTheme.radius-sm;
    background: (ta.has-hover || root.active) ? IdeTheme.control : transparent;

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    menu-text := Text {
        x: 9px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: (ta.has-hover || root.active) ? IdeTheme.text : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Botón compacto de control de ventana.
component IdeWindowButton inherits Rectangle {
    in property <string> glyph: "—";
    in property <bool> danger: false;
    in property <string> tip: "";
    callback activated();

    width: 30px;
    height: 24px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? (root.danger ? #d98c8c33 : IdeTheme.control) : transparent;

    if root.tip != "": Tooltip {
        TipContent { text: root.tip; }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        color: ta.has-hover ? (root.danger ? IdeTheme.del : IdeTheme.text) : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Botón de layout de la barra superior: muestra/oculta un área de la ventana.
// `area`: 0 explorador (izquierda), 1 OpenCode (derecha), 2 terminal (abajo).
component IdeLayoutButton inherits Rectangle {
    in property <int> area: 0;
    in property <bool> active: false;
    callback activated();

    width: 26px;
    height: 24px;
    border-radius: IdeTheme.radius-sm;
    background: ta.has-hover ? IdeTheme.control : transparent;

    // El tooltip explica qué hace cada botón de layout (no son obvios).
    private property <string> tip: root.area == 0 ? "Mostrar u ocultar la región izquierda (explorador y git)"
        : root.area == 1 ? "Mostrar u ocultar la región derecha (OpenCode CLI)"
        : "Mostrar u ocultar la región inferior (terminal)";

    Tooltip {
        TipContent { text: root.tip; }
    }

    private property <color> mark: root.active ? IdeTheme.mint : IdeTheme.text-soft;

    // Marco del área.
    Rectangle {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 14px) / 2;
        width: 16px;
        height: 14px;
        border-width: 1px;
        border-color: root.mark;
        border-radius: 2px;
        background: transparent;

        // Banda que representa el área: 0 izquierda, 1 derecha, 2 abajo.
        if root.area == 0: Rectangle {
            x: 0;
            y: 0;
            width: 5px;
            height: parent.height;
            background: root.mark;
        }
        if root.area == 1: Rectangle {
            x: parent.width - 5px;
            y: 0;
            width: 5px;
            height: parent.height;
            background: root.mark;
        }
        if root.area == 2: Rectangle {
            x: 0;
            y: parent.height - 4px;
            width: parent.width;
            height: 4px;
            background: root.mark;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

// Barra superior: icono + marca, menú, proyecto centrado y controles.
export component IdeTopBar inherits Rectangle {
    in property <string> project: "coquito";
    in property <string> active-menu: "";
    in property <bool> show-left: true;
    in property <bool> show-right: true;
    in property <bool> show-bottom: true;
    callback menu-activated(string);
    callback toggle-region(int);
    callback close-requested();
    // Se clickeó el nombre del proyecto: abrir el selector de carpeta.
    callback project-clicked();
    // Posición de cada ítem de menú: la ventana ancla ahí el desplegable.
    out property <length> file-menu-x: file-item.x;
    out property <length> edit-menu-x: edit-item.x;
    out property <length> view-menu-x: view-item.x;
    out property <length> agent-menu-x: agent-item.x;
    out property <length> help-menu-x: help-item.x;

    height: IdeTheme.topbar-h;
    background: IdeTheme.panel;

    // Grupo izquierdo: logo, marca y menú.
    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: 14px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: @linear-gradient(180deg, #24393a 0%, #172728 100%);
            border-width: 1px;
            border-color: IdeTheme.mint;

            Text {
                width: parent.width;
                height: parent.height;
                text: "N";
                color: IdeTheme.mint;
                font-family: IdeTheme.sans;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: "NuIde";
            color: IdeTheme.text;
            font-family: IdeTheme.sans;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }

        Rectangle { width: 8px; background: transparent; }

        file-item := IdeMenuItem { label: "Archivo"; tip: @tr("Abrir proyecto y archivos, guardar, cerrar pestañas y salir"); active: root.active-menu == "Archivo"; activated => { root.menu-activated(self.label); } }
        edit-item := IdeMenuItem { label: "Editar"; tip: @tr("Deshacer/rehacer, buscar y reemplazar, ir a línea"); active: root.active-menu == "Editar"; activated => { root.menu-activated(self.label); } }
        view-item := IdeMenuItem { label: "Ver"; tip: @tr("Dónde está acoplado cada panel (explorador, OpenCode, terminal, Git): clic para moverlo"); active: root.active-menu == "Ver"; activated => { root.menu-activated(self.label); } }
        IdeMenuItem { label: "Ejecutar"; tip: @tr("Correr el programa SpASM con la configuración activa (F5)"); activated => { root.menu-activated(self.label); } }
        IdeMenuItem { label: "Compilar"; tip: @tr("Transpilar y compilar a binario nativo (Ctrl+B) o compilar y ejecutar (Ctrl+Shift+B)"); activated => { root.menu-activated(self.label); } }
        agent-item := IdeMenuItem { label: "Agente"; tip: @tr("Lanzar OpenCode o Nuide-CLI en el panel del agente"); active: root.active-menu == "Agente"; activated => { root.menu-activated(self.label); } }
        help-item := IdeMenuItem { label: "Ayuda"; tip: @tr("Sintaxis de SpASM, atajos y acerca de NuIde (F1)"); active: root.active-menu == "Ayuda"; activated => { root.menu-activated(self.label); } }
    }

    // Proyecto, centrado en la barra. Es clickeable: abre el selector de carpeta.
    project-text := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.project;
        color: project-hit.has-hover ? IdeTheme.text : IdeTheme.text-soft;
        font-family: IdeTheme.sans;
        font-size: 12px;
        letter-spacing: 0.4px;
        vertical-alignment: center;
    }

    Rectangle {
        x: project-text.x - 12px;
        y: (parent.height - 6px) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: IdeTheme.mint;
    }

    project-hit := TouchArea {
        x: project-text.x - 16px;
        y: (parent.height - 24px) / 2;
        width: project-text.width + 32px;
        height: 24px;
        mouse-cursor: MouseCursor.pointer;

        Tooltip {
            TipContent { text: @tr("Proyecto abierto - clic para elegir otra carpeta"); }
        }

        clicked => { root.project-clicked(); }
    }

    // Controles de layout: barra izquierda, barra derecha y panel inferior.
    // Van a la izquierda de los controles de ventana.
    HorizontalLayout {
        // 3 botones de región (26px + 2px de separación) al lado de los de ventana.
        x: parent.width - 96px - 84px;
        y: (parent.height - 24px) / 2;
        height: 24px;
        spacing: 2px;
        alignment: start;
        cross-axis-alignment: center;

        IdeLayoutButton { area: 0; active: root.show-left;   activated => { root.toggle-region(0); } }
        IdeLayoutButton { area: 1; active: root.show-right;  activated => { root.toggle-region(1); } }
        IdeLayoutButton { area: 2; active: root.show-bottom; activated => { root.toggle-region(2); } }
    }

    // Controles de ventana (decorativos en este esqueleto; cerrar sí cierra).
    IdeWindowButton { x: parent.width - 96px; y: 5px; glyph: "—"; tip: @tr("Minimizar"); activated => { root.menu-activated("Minimizar"); } }
    IdeWindowButton { x: parent.width - 66px; y: 5px; glyph: "▢"; tip: @tr("Maximizar o restaurar"); activated => { root.menu-activated("Maximizar"); } }
    IdeWindowButton { x: parent.width - 36px; y: 5px; glyph: "×"; danger: true; tip: @tr("Salir (pregunta si hay cambios sin guardar)"); activated => { root.close-requested(); } }

    // Línea inferior de 1 px.
    Rectangle {
        y: parent.height - IdeTheme.hairline;
        width: parent.width;
        height: IdeTheme.hairline;
        background: IdeTheme.border-soft;
    }
}
